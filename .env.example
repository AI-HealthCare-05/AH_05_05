OPENAI_API_KEY=실제_API_KEY

OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=public_guidelines_small_v1
QDRANT_TIMEOUT_SECONDS=30

RAG_MIN_SIMILARITY_SCORE=0.65

REDIS_CLAIM_IDLE_MS=60000
REDIS_MAX_ATTEMPTS=3
REDIS_DEAD_LETTER_STREAM=public-guideline-index-jobs-dead

# 로컬 MySQL 설정
DB_ROOT_PASSWORD=local_root_password
DB_NAME=ai_health
DB_USER=ai_health_user
DB_PASSWORD=local_app_password
DB_EXPOSE_PORT=3306
DB_PORT=3306

# 로컬 Docker 이미지 설정
DOCKER_USER=local
DOCKER_REPOSITORY=ai-health
APP_VERSION=dev
AI_WORKER_VERSION=dev
