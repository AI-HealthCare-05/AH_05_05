# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health


# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=change-me
COOKIE_DOMAIN=localhost
USER_REFRESH_ENABLED=false
# /api/v1/** 공통 요청 처리 제한 시간(초)
API_TIMEOUT_SECONDS=3.0

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=localhost
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
DB_NAME=ai_health

# open_AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=10
OPENAI_MAX_RETRIES=2
CONDITIONAL_QUESTION_INTERPRETATION_ENABLED=false
# 로컬에 미리 포함된 다국어 임베딩 모델로 저신뢰도 질문의 경로만 보조 분류합니다.
# 활성화 전 AWS P50/P95와 고정 평가 질문 결과를 기록하세요.
SEMANTIC_ROUTER_ENABLED=false
SEMANTIC_ROUTER_MODEL=intfloat/multilingual-e5-small
SEMANTIC_ROUTER_MIN_SCORE=0.78
SEMANTIC_ROUTER_MIN_MARGIN=0.10
RUN_OPENAI_INTEGRATION_TESTS=false

# LangSmith observability (원문 수집은 가상/데모 데이터에서만 허용)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chat-team-dev
LANGSMITH_ENVIRONMENT=development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_HASH_SALT=
LANGSMITH_CLOSE_TIMEOUT_SECONDS=2
RUN_LANGSMITH_INTEGRATION_TESTS=false

# qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=public_guidelines_small_v1
KNOWLEDGE_QDRANT_COLLECTION=medication_knowledge_full_v10
KNOWLEDGE_DATASET_VERSION=knowledge-full-v10-o200k-source-backed
# DENSE는 기존 단일 벡터 컬렉션, BM25/HYBRID는 named-vector 실험 컬렉션에서 사용
KNOWLEDGE_SEARCH_MODE=DENSE
# 기존 v2는 COSINE 유지. L2 정규화한 신규 릴리스만 DOT으로 생성·조회
KNOWLEDGE_VECTOR_DISTANCE=DOT
INTERACTION_RULE_DATASET_VERSION=interaction-pilot-v1
THERAPEUTIC_CLASS_DATASET_VERSION=therapeutic-class-v1
MEDICATION_SAFETY_RULE_DATASET_VERSION=medication-safety-v2
QDRANT_TIMEOUT_SECONDS=10

# web push
INTERNAL_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# user 개인정보 암호화 (Fernet.generate_key()로 생성, 분실·임의 변경 금지)
PHONE_ENCRYPTION_KEY=

# Redis Worker 재시도
REDIS_CLAIM_IDLE_MS=60000
REDIS_MAX_ATTEMPTS=3
REDIS_DEAD_LETTER_STREAM=public-guideline-index-jobs-dead

# RAG
RAG_MIN_SIMILARITY_SCORE=0.65

# 기본 v3.4.1: 승인된 원근 보정에만 약한 색상·선명화. v3.4.2~v3.4.3은 실험용.
# v3.1.0~v3.1.8, v3.2.1~v3.2.8, v3.3.1도 지원. 실제 설정 변경은 worker 재시작 후 반영된다.
OCR_PREPROCESS_VERSION=v3.4.1

# CLOVA General OCR V3 (OCR worker에서 직접 호출)
CLOVA_GENERAL_OCR_INVOKE_URL=
CLOVA_GENERAL_OCR_SECRET=
