# 이 파일을 .env.local 로 복사해서 쓰세요. .env.local 은 커밋되지 않습니다.

# false 로 두면 실제 백엔드를 호출합니다. 비워두거나 true 면 목업 데이터를 씁니다.
VITE_USE_MOCK=false

# API 기본 경로. 비우면 '/api' — vite dev 서버가 프록시로 백엔드에 넘깁니다.
# VITE_API_BASE_URL=/api

# 백엔드 주소가 다를 때만 바꾸세요(기본 http://127.0.0.1:8000).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
