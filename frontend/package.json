{
  "name": "poke-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ocr": "node -e \"const {spawnSync}=require('node:child_process');const path=require('node:path');const cli=path.join(path.dirname(require.resolve('playwright')),'cli.js');const result=spawnSync(process.execPath,[cli,'test','tests/e2e/medication-registration-flow.spec.ts'],{stdio:'inherit',env:{...process.env,VITE_USE_MOCK:'false'}});process.exit(result.status ?? 1)\""
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "pnpm": "^11.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
