# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=Password1234@
DB_ROOT_PASSWORD=Ozcoding1234@
DB_NAME=ai_health
DB_QUERY_LOG_ENABLED=false

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# internal api
INTERNAL_API_KEY=replace-with-a-long-random-secret

# web push
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_SUBJECT=mailto:admin@example.com

# alarm worker
ALARM_POLL_SECONDS=10
ALARM_MAX_RETRY_COUNT=3
ALARM_RETRY_BASE_SECONDS=30
ALARM_PUSH_TTL_SECONDS=300
ALARM_CLICK_URL=/

# 초기 ADMIN 시드 (scripts/seed_admin.py)
# 관리자는 자체 가입이 없어 최초 1명은 스크립트로 넣는다.
# 시드 후에는 비밀번호를 변경하고 아래 값을 지운다.
SUPERADMIN_EMAIL=admin@ozcoding.ai
SUPERADMIN_PASSWORD=ChangeMe123!@

# 메일 발송
# console = 실제로 보내지 않고 로그로만 출력 (로컬 개발 기본값)
# smtp    = 실제 발송. 아래 SMTP_* 를 모두 채워야 한다
EMAIL_BACKEND=console

# Gmail 을 쓰려면 SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 로 두고
# SMTP_PASSWORD 에는 계정 비밀번호가 아니라 "앱 비밀번호"를 넣어야 한다.
# (Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 에서 발급)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
