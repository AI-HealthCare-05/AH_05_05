# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=Password1234@
DB_ROOT_PASSWORD=Ozcoding1234@
DB_NAME=ai_health
DB_QUERY_LOG_ENABLED=false

# 로그
# root 로거 레벨. uvicorn 의 --log-level 은 uvicorn* 로거에만 적용되므로
# 앱 코드의 로그 레벨은 이 값으로 정한다. DEBUG/INFO/WARNING/ERROR/CRITICAL
LOG_LEVEL=INFO

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# internal api
INTERNAL_API_KEY=replace-with-a-long-random-secret

# web push
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_SUBJECT=mailto:admin@example.com

# alarm worker
ALARM_POLL_SECONDS=10
ALARM_MAX_RETRY_COUNT=3
ALARM_RETRY_BASE_SECONDS=30
ALARM_PUSH_TTL_SECONDS=300
ALARM_CLICK_URL=/

# 초기 ADMIN 시드 (scripts/seed_admin.py)
# 관리자는 자체 가입이 없어 최초 1명은 스크립트로 넣는다.
# 시드 후에는 비밀번호를 변경하고 아래 값을 지운다.
SUPERADMIN_EMAIL=admin@ozcoding.ai
SUPERADMIN_PASSWORD=ChangeMe123!@

# email-worker
# FastAPI는 암호화한 작업만 arq:email 큐에 등록하고 SMTP 발송은 email-worker가 처리한다.
EMAIL_QUEUE_NAME=arq:email
EMAIL_MAX_RETRY_COUNT=3
EMAIL_RETRY_BASE_SECONDS=30
# 배포 시 별도로 생성한 Fernet 키를 시크릿으로 주입한다. 예시 파일에는 값을 두지 않는다.
EMAIL_PAYLOAD_ENCRYPTION_KEY=
SMTP_SETTINGS_ENCRYPTION_KEY=

# 전화번호 암호화
# 위 EMAIL_PAYLOAD_ENCRYPTION_KEY 와 같은 방법으로 생성한다.
# ★ 한번 저장한 전화번호는 이 키로만 복호화된다. 키를 바꾸거나 잃으면
#    기존 번호를 영영 못 읽는다.
#    로컬은 각자 아무 값이나 만들어 쓰면 되지만, 공유 DB 를 쓰면 같은 값이어야 한다.
PHONE_ENCRYPTION_KEY=

# Gmail을 쓰려면 SMTP_HOST=smtp.gmail.com, SMTP_PORT=587로 두고
# SMTP_PASSWORD 에는 계정 비밀번호가 아니라 "앱 비밀번호"를 넣어야 한다.
# (Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 에서 발급)
#
# SMTP_PASSWORD는 예시 파일에 값을 두지 않는다. 배포 시 시크릿으로 주입한다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-account@example.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=replace-with-smtp-account@example.com
