/* =========================================================
   회원
   ========================================================= */
/* 사용자 */
Table user {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  hashed_password varchar(255) [not null, note: '평문 저장 금지. 해시화된 비밀번호 저장']
  status account_status [not null, default: 'PENDING']
  name varchar(100) [not null]
  phone text

  /* [v5-2 신설] 영양소 섭취기준 조회용.
     nutrient_standard 는 (grp, age) 로 조회하므로 성별·나이가 없으면
     기준선(권장·상한)을 정할 수 없다. */
  birth_date date [note: '''
    생년월일. 만나이는 조회 시점에 계산한다.
    ★ 나이를 저장하지 않는다 — 해가 바뀌면 틀린 값이 된다.
    기존 계정에는 값이 없으므로 nullable 이다.
  ''']
  gender gender [note: '''
    성별. nutrient_standard.grp 매칭에 쓴다.
    ★ 주민등록번호 성별코드(1~4)를 저장하지 않는다.
    임신부·수유부는 받지 않는다 — 그 기준값은 증감값(+0 형태)이고
    임신 여부를 수집하지 않으므로 매칭될 경로가 없다.
    기존 계정에는 값이 없으므로 nullable 이다.
  ''']

  created_at datetime [not null, default: `current_timestamp`, note: '유저 생성 일시']
  updated_at datetime [note: '유저 정보 수정 일시']

  indexes {
    status
    created_at
  }

  Note: '''
  실제 서비스 이용자이자 사용자 인증 계정.
  전화번호 등 직접식별정보는 애플리케이션 계층에서 암호화한다.

  [v5] birth_date·gender 는 영양소 섭취기준 조회에만 쓴다.
  (grp, age) 매칭은 서버가 수행하고 API 응답에는 이미 고른 rni·ai·ul 만 담는다 —
  age 표기가 '0-5 (개월)' · '6-11' · '75 이상' 처럼 단위와 형태가 섞여 있어
  클라이언트가 파싱하면 표기 변경마다 화면이 깨진다.
  '''
}
/* 사용자 알림 설정과 시간대별 실제 복용 시각 */
Table user_settings {
  id bigint [pk, increment]
  user_id bigint [not null, note: '사용자']

  is_notify_medication boolean [not null, default: false, note: '복약 알림 수신 여부. alarm_type=MEDICATION 에 적용']

  /* [신설] 영양제 알림.
     alarm_type 의 NUTRIENT 에 대응한다 — 지금까지 대응 컬럼이 없었다.
     마이페이지의 "영양제 알림" 토글이 이 값을 쓴다. */
  is_notify_supplement boolean [not null, default: false, note: '영양제 알림 수신 여부. alarm_type=NUTRIENT 에 적용']

  is_notify_schedule boolean [not null, default: false, note: '진료·검사 일정 알림 수신 여부. alarm_type=FOLLOW_UP_VISIT 에 적용']
  is_notify_guide boolean [not null, default: false, note: '생활관리 가이드 확인 알림 수신 여부. alarm_type=GUIDE_CHECK 에 적용']

  is_terms_agreed boolean [not null, default: false, note: '필수 약관(진료기록 수집 + AI 이용) 동의 여부. 둘을 AND 로 묶어 저장한다']

  terms_agreed_at datetime [note: '필수 약관에 동의한 시각. is_terms_agreed 가 true 로 바뀔 때 기록한다']

  notify_consented_at datetime [note: '''
    알림 수신 여부를 최초로 선택한 시각. 거부를 선택한 경우도 기록한다.

    이 값이 null 인지로 "최초 동의인가"를 판정한다 —
    null 이면 알림 토글을 최초 동의 값으로 초기화하고, 값이 있으면 토글을 건드리지 않는다.
    마이페이지에서 바꾼 설정이 동의 API 재호출로 되돌아가는 것을 막기 위한 기준이다.

    ★ 권한 상태가 아니다. "우리가 물어본 적 있나" 다.
      브라우저 권한(Notification.permission)과 섞지 않는다 —
      권한은 기기별이고 이 값은 사용자 단위다.

    ★ 서버 시각으로 기록한다. 클라이언트가 보내지 않는다.
      (복용 날짜와 반대다 — 그쪽은 사용자가 화면에서 보는 날짜가 정답이라 클라이언트가 보낸다)
  ''']

  morning_medication_time time [not null, default: '08:00']
  lunch_medication_time time [not null, default: '13:00']
  evening_medication_time time [not null, default: '19:00']
  bedtime_medication_time time [not null, default: '22:00']

  Note: '''
  사용자 기본정보를 제외한 셋팅 정보.
  복약 시각 4개는 사용자 단위다 — 진료기록이 2건이어도 환자의 아침 식사 시각은 하나다.
  MORNING < LUNCH < EVENING < BEDTIME 순서와 30분 단위(:00 / :30)는 서버가 검증한다.
  BEDTIME 은 23:30 이하 — 자정을 넘기는 취침 시각은 지원하지 않는다.

  방침이 바뀌어 재동의가 필요하면 is_terms_agreed 를 false, terms_agreed_at 을 null 로
  일괄 리셋한다. 방침 버전 컬럼은 두지 않는다 — 전원 재동의로 갈음한다.

  ── 알림 토글 4개의 현재 상태 ──
  is_notify_medication   화면에 있다 (마이페이지 "복약 알림")
  is_notify_supplement   화면에 있다 (마이페이지 "영양제 알림")
  is_notify_schedule     ★ 화면에 없다. 진료 일정 기능이 이번 범위 밖이다
  is_notify_guide        ★ 화면에 없다. 회복 가이드 기능이 이번 범위 밖이다

  뒤의 둘은 어느 경로에서도 true 로 만들지 않는다 —
  미리 켜두면 나중에 그 기능을 붙일 때 사용자가 동의한 적 없는 알림이 나간다.

  ── 최초 동의와 이후 변경 ──
  notify_consented_at IS NULL   최초. medication 과 supplement 를 함께 true 로 켠다
  notify_consented_at 값 있음    이후. 사용자가 조작한 토글 하나만 바꾼다
  '''
}

/* [v4] set null → cascade.
   user_settings.user_id 가 not null 이라 set null 은 제약 위반으로 삭제가 실패한다. */
Ref: user.id - user_settings.user_id [delete: cascade]


/* [v4 신설] 알림 토글 변경 이력 */
Table user_notify_histories {
  id bigint [pk, increment]
  user_id bigint [not null]
  setting_key notify_setting_key [not null, note: '어느 알림 항목이 바뀌었는지']
  new_value boolean [not null, note: '변경 후 값']
  created_at datetime [not null, default: `current_timestamp`, note: '변경 시각. append-only 라 별도 changed_at 을 두지 않는다']

  indexes {
    (user_id, setting_key, created_at)
    created_at
  }

  Note: '''
  알림 토글(복약 / 일정 / 가이드) 변경 이력만 담는다.
  서버는 이전값과 다를 때만 행을 넣는다 — 알림 설정은 토글 변경 즉시 저장이라
  같은 값으로 요청이 반복될 수 있고, 비교하지 않으면 변화 없는 행이 쌓인다.
  약관 동의는 user_settings.terms_agreed_at 에 시각만 남기고 이력을 만들지 않는다.
  복약 시각(morning_medication_time 등)은 boolean 이 아니라 이 구조로 담을 수 없어 대상이 아니다.

  UPDATE 하지 않고 새 행만 넣는다. user_settings 의 현재값과 중복되지만 의도된 비정규화다 —
  로그인·홈 조회마다 이력을 집계하면 느리고, "현재 사실"과 "감사 기록"은 성격이 다르다.

  "사용자가 알림을 껐다"는 사실은 발송 스킵 판정과 문의 대응에 쓴다.
  알람 행 자체는 지우지 않으므로(alarms Note 참고) 다시 켜면 그대로 살아난다.
  '''
}
Ref: user_notify_histories.user_id > user.id [delete: cascade]

/* 관리자 */
Table admin {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  hashed_password varchar(255) [not null, note: '평문 저장 금지. 해시화된 비밀번호 저장']
  status account_status [not null, default: 'PENDING']
  name varchar(100) [not null]
  role admin_role [not null, default: 'STAFF']
  created_by_admin_id bigint [note: '최초 관리자는 null. 관리자 계정 생성자']
  approved_at datetime [note: '승인 일시']
  created_at datetime [not null, default: `current_timestamp`, note: '생성 일시']
  updated_at datetime [note: '수정 일시']

  indexes {
    role
    status
    created_by_admin_id
    created_at
  }

  Note: '''
  관리자 전용 인증 계정.
  일반 회원가입으로 생성하지 않고 관리자가 생성한다.
  '''
}
Ref: admin.created_by_admin_id > admin.id [delete: set null]

/* =========================================================
   관리자 SMTP 설정
========================================================= */
Table admin_settings {
  id bigint [pk, increment, note: '   식별자']
  setting_key varchar(50) [not null, unique, note: '관리자 설정 구분 키. SMTP 설정은 SMTP 사용']
  smtp_host varchar(255) [not null, note: 'SMTP 서버 주소']
  smtp_port int [not null, note: 'SMTP 서버 포트']
  smtp_user varchar(255) [not null, note: 'SMTP 인증 계정']
  smtp_password_enc varchar(500) [not null, note: 'Fernet으로 암호화된 SMTP 인증 비밀번호']
  smtp_from_email varchar(255) [not null, note: 'SMTP 발신 이메일 주소']
  updated_by_admin_id bigint [not null, note: '설정을 마지막으로 변경한 관리자 식별자']
  created_at datetime [not null, default: `current_timestamp`, note: '설정 생성 일시']
  updated_at datetime [not null, default: `current_timestamp`, note: '설정 최종 수정 일시']

  indexes {
    updated_by_admin_id
    updated_at
  }

  Note: '''
  관리자 콘솔과 email-worker가 사용하는 전역 SMTP 설정.
  setting_key=SMTP 한 건으로 관리하며 비밀번호 평문은 저장하지 않는다.
  '''
}

Ref: admin_settings.updated_by_admin_id > admin.id

/* =========================================================
   care_episode_status
   ========================================================= */
/* 하나의 회복·관리 목적을 지속적으로 추적하는 케어 단위 */
Table care_episodes {
  id bigint [pk, increment]
  user_id bigint [not null, note: "케어 소유 사용자"]
  alias varchar(255) [note: '''
    [v1.2.5 변경 설계] 처방의 단일 표시 이름. 기존 title 역할을 이 컬럼으로 통합한다.
    홈·처방 목록·기록 상세·복약 메모 등에서 같은 표시 규칙을 사용한다.
    사용자 별칭은 앞뒤 공백을 제거하고 우선 보존한다.
    별칭이 비어 있으면 확인된 병원명을 기본값으로 사용한다.
    병원명도 없으면 null로 두고 화면에서 기존처럼 「{조제일} 처방」으로 표시한다.
    날짜 기반 대체 문구나 복약 기록 같은 고정 문구를 DB 기본값으로 저장하지 않는다.
    병원명 최대 255자와 기존 제목 최대 150자를 수용하도록 255자로 확장한다.
    사용자가 별칭을 수정해도 hospital_name 원본은 변경하지 않는다.
  ''']
  status care_episode_status [not null, default: 'ACTIVE']
  hospital_name varchar(255) [note: '''
    [v1.2.5 추가] OCR 추출 후 사용자가 확인·수정한 병원명. 미추출이면 null.
    alias와 별도 보존한다. 별칭을 바꿔도 병원명 자체를 바꾸지 않는다.
    [v1.2.5 변경 설계] 별칭이 없으면 병원명을 alias 기본값으로 사용하며 50자로 절단하지 않는다.
    병원명도 없으면 alias는 null, 표시 이름은 기존 날짜 기반 대체 문구를 사용한다.
    병원명은 행별 값이므로 DB의 상수 DEFAULT가 아니라 애플리케이션에서 처리한다.
  ''']
  /* OCR 사용자 확정 결과 */
  medication_days int [note: "확정 약 목록에서 null이 아닌 medications.days의 최대값. 값이 있으면 1~365일"]
  source_ocr_job_id bigint [note: "현재 확정값을 만든 OCR 작업"]
  confirmation_hash varchar(64) [note: "클라이언트 confirm body의 scalar·배열·tempId를 canonicalize한 SHA-256. 서버 소유 category·confidence·source는 제외한다"]
  confirmed_at datetime [note: "OCR 결과 최종 저장 시각. 조제약 OCR에서는 미확정 CareEpisode를 만들지 않고 사용자 확정 시 이 값을 포함한 ACTIVE CareEpisode를 생성한다. 비 OCR 경로에서는 null일 수 있다"]
  medication_start_date date [note: '복약 공통 시작일. 조제약 OCR 확정 시 약봉투 조제일로 초기화하고 복약 시간 설정에서 사용자가 실제 시작일로 수정할 수 있다']
  medication_start_slot meal_slot [note: '첫날 최초 복용 슬롯. 첫날에는 이 슬롯보다 앞선 복약 알림을 건너뛴다']
  completed_at datetime [note: "실제 케어 종료 시각"]
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime
  indexes {
    (user_id, status)
  }
  checks {
    `medication_days IS NULL OR (medication_days BETWEEN 1 AND 365)`
    `(source_ocr_job_id IS NULL AND confirmed_at IS NULL AND confirmation_hash IS NULL) OR (source_ocr_job_id IS NOT NULL AND confirmed_at IS NOT NULL AND confirmation_hash IS NOT NULL)`
  }
  Note: '''
  [v1.2.5 현재 구현]
  화면의 종료일은 medication_start_date와 medications.days(누락 시 medication_days 등 대체값)로 계산한다.
  기록 생성 시각은 created_at, 실제 복약 시작일은 medication_start_date, 첫 시간대는 medication_start_slot이다.
  시각(HH:MM)은 user_settings의 4개 medication_time, 약별 시간대는 medication_slots에서 관리한다.
  실제 복용 체크는 medication_doses, 발송 일정은 alarms에서 관리한다. alarms.completed_at은 케어 완료가 아니다.
  care_episodes.completed_at은 현재 서비스에서 기록하지 않으며 별도 전체 복용 완료 기록도 없다.
  [v1.2.9 로컬 실행 DB 적용 확인]
  이 ERD에서는 진단·수술·퇴원일과 별도 제목 컬럼을 제거하고 표시 이름을 alias로 통합했다.
  별도 케어 시작 시각과 기본·변경 종료 예정 시각도 제거했다. 종료 예정일은 복약 정보로 계산한다.
  completed_at은 실제 케어 종료 시각으로 유지하며, 실제 구현 시 완료 상태 전환과 함께 기록해야 한다.
  현재 코드와 로컬 실행 DB ai_health에 migration 39의 케어 구조 정리가 반영돼 있다.
  alias는 nullable VARCHAR(255)이며 기존 제목·진단·수술·퇴원일·시작 시각·종료 예정 시각 컬럼은 제거됐다.
  마이그레이션은 삭제 대상 데이터와 관련 출처 이력을 백업하고 기존 사용자 별칭을 보존한다.
  별칭이 없는 행은 병원명으로 채우며 병원명도 없으면 null을 유지한다.
  화면의 날짜 기반 대체 표시를 DB 기본값으로 저장하지 않는다. 별도 배포 서버 DB 적용 여부는 이 확인에 포함하지 않는다.

  현재 조제약 OCR 최초 확정에서는 작업별로 새 처방 케어를 생성한다.
  한 사용자는 여러 ACTIVE 케어를 가질 수 있고 종료된 케어도 이력으로 보관한다.

  복약 기간은 medication_start_date와 약별 복용 일수로 계산한다.
  종료 예정일은 별도 컬럼에 중복 저장하지 않으며, 실제 케어 완료 상태·시각과 구분한다.
  "7일분"은 먹기 시작한 날부터 센다. 기간 경과와 실제 복용 완료를 동일하게 취급하지 않는다.

  조제약 OCR 흐름에서는 OCR 요청 단계에 이 행을 만들지 않는다.
  사용자가 최종 확정할 때 ACTIVE 상태로 생성하고 medication_start_date에는 약봉투 조제일,
  medication_days에는 확정 약 목록의 최대 days를 저장한다.

  OCR 확정 직후 복약 시간 설정 화면이 이어진다. 이 화면의 저장 또는 건너뛰기 요청이
  medication_start_date·medication_start_slot과 medication_slots를 확정한다.

  확정 source OCR job은 개별 hard delete하지 않는다.
  episode 전체 삭제 시 source_ocr_job_id·confirmation_hash·confirmed_at을 먼저 함께 null로 만든 뒤 episode를 삭제한다.
  '''
}
Ref: care_episodes.user_id > user.id [delete: cascade]

/* =========================================================
   OCR
   ========================================================= */
/* 사용자가 업로드한 OCR 구조화 작업. CareEpisode 없이 시작하고 확정 시 연결할 수 있다. */
Table ocr_jobs {
  id bigint [pk, increment, note: "서버 내부 OCR 시도 식별자. API 의 ocrJobId"]
  user_id bigint [not null, note: "OCR 작업 요청자. 작업 소유권 검사와 멱등성 기준"]
  care_episode_id bigint [note: "확정 전에는 null. 사용자 확정 시 생성되거나 선택된 CareEpisode를 연결"]
  status ocr_job_status [not null, default: 'QUEUED', note: "OCR 구조화 및 사용자 확정 상태"]
  idempotency_key varchar(100) [not null, note: "같은 사용자의 동일 업로드 요청 중복 생성 방지. 파일 동일성은 input_manifest의 fingerprint로 검증"]
  input_manifest json [not null, note: "업로드한 약봉투·조제약 복약안내 이미지 한 장의 content hash·요청 fingerprint·임시 저장 메타데이터"]
  structured_result json [note: "READY_FOR_REVIEW에서는 확인·수정용 구조화 후보, COMPLETE에서는 사용자가 확정한 최종 결과 스냅샷"]
  ocr_model varchar(100) [not null, note: "사용한 OCR 공급자·모델 버전"]
  structuring_model varchar(100) [note: "조제일·함량 후보가 충돌해 LLM을 호출한 경우 사용한 모델. LLM 미호출이면 null"]
  prompt_version varchar(100) [note: "LLM을 호출한 경우 사용한 프롬프트 버전. LLM 미호출이면 null"]
  schema_version varchar(50) [not null, note: "구조화 결과 계약 버전. 조제약 OCR v3는 v3 저장"]
  stage_results json [note: '''
    [v1.2.5 현재 구현] {"timings": ..., "stages": [...]} 객체로 저장한다. 컬럼 타입은 JSON으로 유지한다.
    timings: queueWaitMs(큐 대기), persistMs(결과 저장), totalMs(큐·재시도 대기를 포함한 전체 경과 시간).
    측정하지 않은 값은 null이며 추정값을 생성하지 않는다. 별도 시간 컬럼은 추가하지 않는다.
    stages: preprocess·ocr·candidate·resolve·llm·validate 순서의 단계별 결과 배열.
    각 단계는 name·status·elapsedMs·callCount와 선택적 code만 저장한다.
    과거 resolve 없는 5단계 기록과 배열형 stage_results도 호환해서 읽는다.
    단계별 elapsedMs는 그대로 보존하며 timings.totalMs를 단계 시간의 합으로 바꾸지 않는다.
    애플리케이션 조회 시 timings 다음 stages 순서를 복원하지만 MySQL JSON 원문 키 순서는 보장하지 않는다.
    의료 원문이나 추출값은 포함하지 않는다.
  ''']
  avg_field_confidence decimal(5,4) [note: "추출된 조제일 및 약별 5개 필드의 숫자 confidence 산술평균. 미추출 필드는 제외"]
  confidence_field_count int [note: "avg_field_confidence 계산에 포함된 추출 필드 수"]
  user_review_match_rate decimal(5,4) [note: "최초 OCR 후보와 사용자 최종 확정값의 필드별 일치율. 실제 정답 정확도가 아닌 사용자 검토 기준 지표"]
  error_code varchar(100) [note: "의료 원문을 포함하지 않는 공개 오류 코드"]
  started_at datetime [note: "작업 처리 시작 시각"]
  ready_at datetime [note: "구조화 후보가 검토 가능해진 시각"]
  expires_at datetime [note: "검토 후보 자동 만료 시각"]
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime
  completed_at datetime [note: "COMPLETE·FAILED·CANCELLED 종료 시각"]
  indexes {
    (user_id, idempotency_key) [unique]
    (care_episode_id, status)
    (id, care_episode_id) [unique]
    expires_at
  }
  checks {
    `structured_result IS NULL OR status IN ('READY_FOR_REVIEW', 'COMPLETE')`
    `status <> 'READY_FOR_REVIEW' OR (structured_result IS NOT NULL AND ready_at IS NOT NULL AND expires_at IS NOT NULL)`
    `(status = 'FAILED' AND error_code IS NOT NULL AND error_code IN ('OCR_PROVIDER_ERROR', 'OCR_PROVIDER_TIMEOUT', 'EXTRACTION_FAILED', 'VALIDATION_FAILED', 'WORKER_INTERRUPTED', 'RECAPTURE_REQUIRED')) OR (status = 'CANCELLED' AND error_code IS NOT NULL AND error_code IN ('USER_CANCELLED', 'REVIEW_EXPIRED')) OR (status IN ('QUEUED', 'PROCESSING', 'READY_FOR_REVIEW', 'COMPLETE') AND error_code IS NULL)`
    `(status IN ('COMPLETE', 'FAILED', 'CANCELLED') AND completed_at IS NOT NULL) OR (status IN ('QUEUED', 'PROCESSING', 'READY_FOR_REVIEW') AND completed_at IS NULL)`
    `(status = 'QUEUED' AND started_at IS NULL AND ready_at IS NULL AND expires_at IS NULL) OR (status = 'PROCESSING' AND started_at IS NOT NULL AND ready_at IS NULL AND expires_at IS NULL) OR (status = 'READY_FOR_REVIEW' AND started_at IS NOT NULL AND ready_at IS NOT NULL AND expires_at IS NOT NULL) OR (status IN ('COMPLETE', 'FAILED') AND started_at IS NOT NULL AND ready_at IS NULL AND expires_at IS NULL) OR (status = 'CANCELLED' AND ready_at IS NULL AND expires_at IS NULL)`
    `started_at IS NULL OR started_at >= created_at`
    `ready_at IS NULL OR (started_at IS NOT NULL AND ready_at >= started_at)`
    `completed_at IS NULL OR completed_at >= COALESCE(started_at, created_at)`
    `expires_at IS NULL OR ready_at IS NULL OR expires_at > ready_at`
    `avg_field_confidence IS NULL OR (avg_field_confidence BETWEEN 0 AND 1)`
    `confidence_field_count IS NULL OR confidence_field_count >= 0`
    `user_review_match_rate IS NULL OR (user_review_match_rate BETWEEN 0 AND 1)`
  }
  Note: '''
  한 행은 한 사용자가 실행한 OCR 구조화 작업 하나다.
  조제약 OCR 요청 단계에서는 care_episode_id가 null이며,
  사용자가 최종 확정할 때 CareEpisode를 생성한 뒤 연결한다.

  input_manifest에는 업로드한 약봉투·조제약 복약안내 이미지 한 장의 입력 메타데이터와
  동일 요청 판별에 사용하는 fingerprint를 보존한다. 퇴원 문서는 이 흐름의 입력이 아니다.
  같은 user_id와 idempotency_key이고 fingerprint도 같으면 기존 작업을 반환한다.
  같은 사용자·키에 다른 fingerprint를 사용하면 409로 거부한다.

  structured_result는 READY_FOR_REVIEW에서 사용자 확인·수정용 후보로 사용하고,
  COMPLETE에서는 사용자가 확정한 최종 결과 스냅샷으로 보존한다.
  OCR 원문 JSON과 LLM 원응답은 영구 저장하지 않는다.

  stage_results는 각 단계가 끝난 순서대로 저장하고 사용자 확정 이후에도 최초 실행 결과를 유지한다.
  status는 succeeded·skipped·failed를 사용한다. callCount는 외부 OCR·LLM 호출 횟수이므로
  내부 처리 단계인 preprocess·candidate·validate는 정상 완료되어도 0일 수 있다.

  avg_field_confidence와 confidence_field_count는 READY_FOR_REVIEW 진입 시 계산하고
  COMPLETE 이후에도 최초 OCR 품질 지표로 유지한다. doseQuantity의 value와 unit은 한 필드로 계산한다.
  user_review_match_rate는 확정 트랜잭션에서 최초 후보와 최종 확정값을 비교해 기록하며,
  사용자가 확정하지 않은 작업은 null로 둔다.

  조제약 OCR 사용자 확정이 성공하면 확정값을 care_episodes와 medications에 저장한다.
  follow_up_visits는 조제약 약봉투 OCR 확정 대상이 아니다.
  클라이언트 confirm body의 canonical confirmation hash를 care_episodes.confirmation_hash에 함께 기록한다.
  COMPLETE 재요청은 confirmation_hash를 비교하여 같은 요청에는 기존 확정 결과를 반환한다.
  다른 요청은 기본적으로 409로 거부하되 등록 수정 요청에 한해 제한적으로 교체를 허용한다.
  수정은 ACTIVE 케어이고 medication_start_slot이 null이며 약별 슬롯·복용 기록·복약 메모가 없는 경우에만 허용한다.
  허용된 수정에서는 같은 케어의 약 목록을 교체하고 confirmation_hash와 최종 구조화 스냅샷을 갱신한다.
  확정 후에는 작업을 COMPLETE로 변경하고 structured_result에 최종 확정 스냅샷을 보존한다.
  READY_FOR_REVIEW 이후 60분이 지나면 만료된 미확정 작업·임시 결과·원본 이미지를 삭제한다.
  최초 확정된 OcrJob 하나는 CareEpisode 하나와 연결된다. 위 등록 수정 예외에서도 새 케어를 추가하지 않는다.
  '''
}
Ref: ocr_jobs.user_id > user.id [delete: cascade]
Ref: ocr_jobs.care_episode_id > care_episodes.id [delete: set null]
Ref: care_episodes.(source_ocr_job_id, id) > ocr_jobs.(id, care_episode_id) [delete: restrict]

/* =========================================================
   CHAT
   ========================================================= */
Table chat_sessions {
  id bigint [pk, increment]
  user_id bigint [not null, note: '세션 소유자. 답변 근거는 이 사용자의 활성 케어·약·영양제 전체에서 모은다.']
  care_episode_id bigint [note: '세션을 시작한 케어. 계정 단위 일반 세션이면 null이며 grounding 범위가 아니다.']
  status chat_session_status [not null, default: 'ACTIVE']
  is_like boolean [note: '챗봇 응답 좋아요 여부. 미평가 시 null']
  reason_code varchar(20) [note: '챗봇 평가 사유 코드. 미선택 시 null']
  last_message_at datetime
  deleted_at datetime
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    (user_id, status, last_message_at)
    (care_episode_id, status)
    last_message_at
  }

  Note: '''
  최신 ERD의 care_episode_id를 시작 화면 맥락으로 유지한다.
  답변 근거는 care_episode_id 하나로 제한하지 않고 user_id 기준 활성 케어·약·영양제 전체에서 모은다.
  '''
}

Table chat_messages {
  id bigint [pk, increment]
  chat_session_id bigint [not null]
  reply_to_message_id bigint [note: 'ASSISTANT 메시지가 답변한 USER 메시지']
  request_id varchar(100) [note: '중복 요청 방지와 실행 추적용 식별자']
  sequence_no int [not null]
  role chat_message_role [not null]
  content text [not null]
  status chat_message_status [not null, default: 'PENDING']
  route_type chat_route_type
  safety_status chat_safety_status [not null, default: 'PENDING']
  safety_reason_code varchar(100) [note: '안전성 검사에서 선택한 대표 사유 코드']
  model_name varchar(100)
  model_version varchar(100)
  prompt_version varchar(100)
  schema_version varchar(50)
  session_reference json [note: '최근 대화에서 확정한 제품·성분 참조. 후속 질문 해석에 사용']
  patient_context_hash varchar(64) [note: '답변에 사용한 활성 케어·약·영양제 컨텍스트의 canonical SHA-256']
  langsmith_trace_id varchar(100)
  error_code varchar(100)
  duration_ms int [note: '직접 처리한 채팅 응답의 전체 소요시간. P95 평가용']
  started_at datetime
  completed_at datetime
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    (chat_session_id, sequence_no) [unique]
    reply_to_message_id
    request_id
    langsmith_trace_id
    created_at
  }

  checks {
    `duration_ms IS NULL OR duration_ms >= 0`
  }

  Note: '''
  검증 상태와 권고 충돌 상태를 유지한다.
  INTERACTION 경로에서는 승인된 상호작용 규칙만 사용하고 안전하지 않은 답변은 safety_status로 차단한다.
  duration_ms는 전체 채팅 API의 P95 응답시간을 측정하는 데 사용한다.
  '''
}

Table chat_message_sources {
  id bigint [pk, increment]
  chat_message_id bigint [not null, note: '출처가 연결된 ASSISTANT 메시지']
  source_type chat_source_type [not null]

  patient_source_kind patient_source_kind [note: 'PATIENT_SAVED_FIELD인 경우 확정 데이터 종류']
  patient_field care_episode_source_field [note: 'CARE_EPISODE_FIELD인 경우 사용한 필드']
  care_episode_id bigint [note: 'CARE_EPISODE_FIELD 출처의 실제 케어 ID. 세션 시작 케어와 다를 수 있다']
  medication_id bigint [note: 'patient_source_kind=MEDICATION인 경우 medications.id']
  follow_up_visit_id bigint [note: 'patient_source_kind=FOLLOW_UP_VISIT인 경우 follow_up_visits.id']
  user_suppl_nutrient_id bigint [note: 'USER_SUPPLEMENT 출처인 경우 사용자 영양제 등록 ID']
  interaction_rule_id bigint [note: 'INTERACTION_RULE 출처인 경우 승인된 규칙 ID']
  medication_safety_rule_id bigint [note: 'MEDICATION_SAFETY_RULE 출처인 경우 승인된 단일 약물 안전 규칙 ID']

  public_dataset_key varchar(100) [note: 'PUBLIC_RAG_CHUNK 데이터셋 키']
  dataset_version varchar(100) [note: 'Qdrant 불변 데이터셋 버전']
  vector_chunk_id varchar(255) [note: 'Qdrant point 또는 청크 ID']
  source_record_key varchar(100) [note: '최신 v1.0.6과 동일한 원본 문서·레코드 식별자']
  source_field varchar(100) [note: '문서 섹션 또는 원본 필드']
  chunk_type varchar(100) [note: '정규화된 청크 정보 유형']
  source_title varchar(255)
  source_organization varchar(255)
  source_url text
  source_page_number int
  source_license varchar(255)
  similarity_score decimal(5,4)
  citation_order int [not null]
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    chat_message_id
    care_episode_id
    medication_id
    follow_up_visit_id
    user_suppl_nutrient_id
    interaction_rule_id
    medication_safety_rule_id
    (chat_message_id, citation_order) [unique]
    (public_dataset_key, source_record_key)
    vector_chunk_id
  }

  checks {
    `(source_type = 'PATIENT_SAVED_FIELD' AND patient_source_kind IS NOT NULL AND user_suppl_nutrient_id IS NULL AND interaction_rule_id IS NULL AND medication_safety_rule_id IS NULL AND public_dataset_key IS NULL AND vector_chunk_id IS NULL)
      OR (source_type = 'USER_SUPPLEMENT' AND patient_source_kind IS NULL AND patient_field IS NULL AND care_episode_id IS NULL AND medication_id IS NULL AND follow_up_visit_id IS NULL AND user_suppl_nutrient_id IS NOT NULL AND interaction_rule_id IS NULL AND medication_safety_rule_id IS NULL AND public_dataset_key IS NULL AND vector_chunk_id IS NULL)
      OR (source_type = 'INTERACTION_RULE' AND patient_source_kind IS NULL AND patient_field IS NULL AND care_episode_id IS NULL AND medication_id IS NULL AND follow_up_visit_id IS NULL AND user_suppl_nutrient_id IS NULL AND interaction_rule_id IS NOT NULL AND medication_safety_rule_id IS NULL AND public_dataset_key IS NULL AND vector_chunk_id IS NULL)
      OR (source_type = 'MEDICATION_SAFETY_RULE' AND patient_source_kind IS NULL AND patient_field IS NULL AND care_episode_id IS NULL AND medication_id IS NULL AND follow_up_visit_id IS NULL AND user_suppl_nutrient_id IS NULL AND interaction_rule_id IS NULL AND medication_safety_rule_id IS NOT NULL AND public_dataset_key IS NULL AND vector_chunk_id IS NULL)
      OR (source_type = 'PUBLIC_RAG_CHUNK' AND patient_source_kind IS NULL AND patient_field IS NULL AND care_episode_id IS NULL AND medication_id IS NULL AND follow_up_visit_id IS NULL AND user_suppl_nutrient_id IS NULL AND interaction_rule_id IS NULL AND medication_safety_rule_id IS NULL AND public_dataset_key IS NOT NULL AND dataset_version IS NOT NULL AND vector_chunk_id IS NOT NULL AND source_record_key IS NOT NULL)`
    `(patient_source_kind = 'CARE_EPISODE_FIELD' AND patient_field IS NOT NULL AND care_episode_id IS NOT NULL AND medication_id IS NULL AND follow_up_visit_id IS NULL)
      OR (patient_source_kind = 'MEDICATION' AND patient_field IS NULL AND care_episode_id IS NULL AND medication_id IS NOT NULL AND follow_up_visit_id IS NULL)
      OR (patient_source_kind = 'FOLLOW_UP_VISIT' AND patient_field IS NULL AND care_episode_id IS NULL AND medication_id IS NULL AND follow_up_visit_id IS NOT NULL)
      OR patient_source_kind IS NULL`
    `(source_type = 'PUBLIC_RAG_CHUNK' AND public_dataset_key IS NOT NULL AND dataset_version IS NOT NULL AND vector_chunk_id IS NOT NULL AND source_record_key IS NOT NULL)
      OR (source_type <> 'PUBLIC_RAG_CHUNK' AND public_dataset_key IS NULL AND dataset_version IS NULL AND vector_chunk_id IS NULL AND source_record_key IS NULL AND source_field IS NULL AND chunk_type IS NULL AND source_title IS NULL AND source_organization IS NULL AND source_url IS NULL AND source_page_number IS NULL AND source_license IS NULL AND similarity_score IS NULL)`
    `source_page_number IS NULL OR source_page_number >= 1`
    `similarity_score IS NULL OR (similarity_score >= 0 AND similarity_score <= 1)`
    `citation_order >= 1`
  }

  Note: '''
  최신 ERD의 환자 확정정보와 공공 RAG 출처 구조를 유지한다.
  사용자 영양제와 승인 상호작용 규칙 출처만 추가하여 실제 답변 근거를 추적한다.
  계정 전체 활성 케어를 grounding하므로 CARE_EPISODE_FIELD는 care_episode_id로 실제 출처를 남긴다.
  '''
}

Ref: chat_sessions.user_id > user.id [delete: cascade]
Ref: chat_sessions.care_episode_id > care_episodes.id [delete: cascade]
Ref: chat_sessions.id < chat_messages.chat_session_id [delete: cascade]
Ref: chat_messages.id < chat_messages.reply_to_message_id [delete: set null]
Ref: chat_messages.id < chat_message_sources.chat_message_id [delete: cascade]
Ref: care_episodes.id < chat_message_sources.care_episode_id [delete: restrict]
Ref: medications.id < chat_message_sources.medication_id [delete: restrict]
Ref: follow_up_visits.id < chat_message_sources.follow_up_visit_id [delete: restrict]
Ref: user_suppl_nutrient.id < chat_message_sources.user_suppl_nutrient_id [delete: restrict]
Ref: interaction_rules.id < chat_message_sources.interaction_rule_id [delete: restrict]
Ref: medication_safety_rules.id < chat_message_sources.medication_safety_rule_id [delete: restrict]
/* =========================================================
   ALARM
   ========================================================= */

/* 사용자 기기별 웹 푸시 구독 정보 */
Table push_subscriptions {
  id bigint [pk, increment]
  user_id bigint [not null, note: "구독 소유자"]
  endpoint varchar(500) [not null, unique, note: "브라우저가 발급한 푸시 엔드포인트 URL"]
  p256dh_key varchar(255) [not null]
  auth_key varchar(255) [not null]
  platform varchar(50) [note: "ios / android / desktop 등"]
  user_agent varchar(255)
  is_active boolean [not null, default: true, note: "구독 만료·해지 시 false 처리. 발송 시 410 Gone·404 응답을 받으면 false 로 바꾼다"]
  created_at datetime [not null, default: `current_timestamp`]
  last_used_at datetime

  indexes {
    (user_id, is_active)
  }

  Note: '''
  사용자 1명이 여러 기기(브라우저)를 등록할 수 있으므로, 알람 발송 시 각 기기가 fan-out 대상이 된다.
  구독 해지는 행 삭제가 아니라 is_active=false 다 — alarm_events.push_subscription_id 가
  이 행을 참조하므로 지우면 발송 이력이 끊긴다.
  '''
}

/* 복약·추적 일정·가이드 확인 알림 등 예약된 알람 정의 */
Table alarms {
  id bigint [pk, increment]
  user_id bigint [not null, note: "알람 대상 사용자"]

  /* [v4] MEDICATION 은 케어를 특정할 수 없다 —
     사용자 × meal_slot 단위로 활성 케어 전체의 약을 통합하기 때문이다. */
  care_episode_id bigint [note: 'FOLLOW_UP_VISIT·GUIDE_CHECK 의 대상 케어. MEDICATION 은 활성 케어 전체를 통합하므로 null']

  /* [v4] 주석. CUSTOM 타입 제거 반영 */

  alarm_type alarm_type [not null, default: 'MEDICATION']
  meal_slot meal_slot [note: 'MEDICATION 알람의 시간대. 그 외 타입은 null']

  /* [v4] 어느 외래 일정의 알람인지.
     케어에 일정이 3건이면 이 값 없이는 구분할 수 없고,
     일정 시각이 바뀌었을 때 어느 알람을 갱신할지도 알 수 없다. */
  follow_up_visit_id bigint [note: 'FOLLOW_UP_VISIT 알람의 대상 일정. 그 외 타입은 null']

  title varchar(255) [not null, note: '관리 화면 표시용 라벨. 발송 문구는 발송 직전에 다시 만든다']

  message varchar(500)
  scheduled_at datetime [not null, note: "최초 등록된 발송 예정 시각"]
  recurrence_rule varchar(100) [note: "RRULE 형식. null이면 단발성"]
  timezone varchar(50) [not null, default: 'Asia/Seoul', note: 'KST 단일 고정이라 상수로만 채워진다. 해외 확장 전까지 분기 조건으로 쓰지 않는다']
  next_trigger_at datetime [not null, note: "다음 발송 예정 시각. 매 발송마다 재계산되어 갱신됨"]
  status alarm_status [not null, default: 'ACTIVE']
  last_triggered_at datetime

  /* [v5-1] 주석 정정.
     v4 는 "복약 완료 체크 UI 는 만들지 않으므로 사용자 조작으로는 채워지지 않는다" 였다.
     그 결정이 뒤집혀 홈에 [N개 먹었어요] 버튼과 복약 기록 화면이 생겼다.
     다만 복용 체크는 이 컬럼이 아니라 medication_doses 에 저장한다 — 이유는 그 테이블 Note 참고. */
  completed_at datetime [note: '''
    알람이 종료된 시각. 복약 기간 만료 등 시스템 판정으로만 채워진다.
    사용자의 "먹었어요" 조작은 이 컬럼과 무관하다 — medication_doses 에 기록한다.
  ''']

  cancelled_at datetime
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    (user_id, status)
    (status, next_trigger_at) [name: 'idx_due_alarms', note: "발송 대상 스케줄러 폴링용"]
    care_episode_id
    (user_id, alarm_type, meal_slot) [unique, note: '사용자별 복약 슬롯 알람을 최대 4개로 유지']
  }

  checks {
    /* [수정] NUTRIENT 도 meal_slot 을 갖는다 */
    `(alarm_type IN ('MEDICATION','NUTRIENT') AND meal_slot IS NOT NULL)
      OR (alarm_type NOT IN ('MEDICATION','NUTRIENT') AND meal_slot IS NULL)`

    /* FOLLOW_UP_VISIT 은 follow_up_visit_id 가, GUIDE_CHECK 은 care_episode_id 가 필요하다.
       타입별 전체 제약은 백엔드 구현 시 함께 넣기를 권한다. */
  }

  Note: '''
  타입별 단위가 다르다.
    MEDICATION      — (사용자 × meal_slot). 사용자당 최대 4행. 활성 케어 전체의 약을 통합한다.
    NUTRIENT        — ★ (사용자 × meal_slot). 사용자당 최대 4행.
                      등록한 영양제 전체를 슬롯 단위로 통합한다. care_episode_id 는 null 이다
                      (영양제는 케어에 묶이지 않는다).
    FOLLOW_UP_VISIT — 일정 1건당 1행. 단발성.
    GUIDE_CHECK     — 케어 1건당 1행.

  (user_id, alarm_type, meal_slot) 유니크는 그대로 둔다 —
  NUTRIENT 도 사용자당 슬롯별 1행이라 같은 구조다.

  약이 추가·삭제돼도 MEDICATION 알람 행은 그대로다. title/message 는 고정 약 목록의 원본이 아니며,
  발송 직전에 해당 슬롯의 활성 약을 다시 조회해 최종 문구를 만든다.
  발송 시각은 user_settings 의 시간대별 시각을 조인해 얻는다.

  발송 직전 확인 순서 — 하나라도 걸리면 alarm_events 에 SKIPPED 로 기록한다.
    1. user_settings 의 해당 타입 토글이 false
       ★ NUTRIENT 는 is_notify_supplement 를 본다
    2. push_subscriptions 에 활성 행이 없음
    ...
  '''
}

/* 알람 1건의 생명주기 이벤트(예약/발송/수신/완료/스킵/실패) 로그 */
Table alarm_events {
  id bigint [pk, increment]
  alarm_id bigint [not null]
  event_type alarm_event_type [not null]
  push_subscription_id bigint [note: "SENT/DELIVERED 이벤트에서 실제 발송된 기기. 그 외 이벤트는 null"]
  event_at datetime [not null, default: `current_timestamp`]
  payload json [note: "발송 시점 알림 문구(title/body/click_url) 스냅샷"]
  error_code varchar(100)
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (alarm_id, event_type)
    event_at
  }

  Note: '''
  알람 1건이 여러 기기로 fan-out 되면 SENT/DELIVERED 이벤트가 기기(push_subscription)별로 여러 행 생성된다.
  실제 발송 작업의 큐 상태(대기/처리중/성공/실패, 재시도)는 background_jobs에서 별도로 추적한다.
  Web Push 서버의 성공 응답은 요청 접수(SENT)를 뜻한다. DELIVERED는 서비스 워커가 별도 수신 확인 API를 호출한 경우에만 기록한다.

  [v5] event_type 의 COMPLETED·SKIPPED 는 "발송 파이프라인 관점"의 결과다.
  사용자가 약을 먹었다는 사실은 medication_doses 에 기록한다 —
  이 테이블은 alarm_id 가 NOT NULL 이라 알림을 쓰지 않는 사용자의 복용을 담을 수 없다.
  '''
}

Ref: push_subscriptions.user_id > user.id [delete: cascade]
Ref: alarms.user_id > user.id [delete: cascade]
Ref: alarm_events.alarm_id > alarms.id [delete: cascade]
Ref: alarm_events.push_subscription_id > push_subscriptions.id [delete: set null]
Ref: alarms.care_episode_id > care_episodes.id [delete: cascade]

/* [v4] 외래 일정이 삭제되면 그 일정의 알람도 함께 사라진다 */
Ref: alarms.follow_up_visit_id > follow_up_visits.id [delete: cascade]

/* =========================================================
   BACKGROUND JOB (통합 처리 작업 로그)
   ========================================================= */

/* OCR·챗봇 응답·알람 발송·데이터 삭제 등 비동기 처리 작업을 한 화면에서 조회하기 위한 통합 로그 */
Table email_verifications [note: '회원가입 이메일 인증 요청과 일회성 인증 상태 관리'] {
  id bigint [pk, increment, note: '이메일 인증 식별자']
  email varchar(255) [not null, note: '인증 대상 이메일']
  purpose varchar(30) [not null, note: '인증 목적(SIGNUP)']
  code_digest char(64) [not null, note: '인증번호 HMAC-SHA256 결과']
  expires_at datetime [not null, note: '인증번호 만료 시각']
  attempt_count int [not null, default: 0, note: '인증번호 확인 실패 횟수(0~5)']
  verified_at datetime [note: '인증 성공 시각']
  consumed_at datetime [note: '회원가입에서 토큰을 소비한 시각']
  created_at datetime [not null, note: '인증 요청 시각']
  updated_at datetime [note: '최종 변경 시각']

  indexes {
    (email, purpose, created_at) [name: 'idx_email_verification_lookup']
    expires_at [name: 'idx_email_verification_expiry']
    (verified_at, consumed_at) [name: 'idx_email_verification_state']
  }

  checks {
    `attempt_count between 0 and 5`
  }
}

Table background_jobs {
  id bigint [pk, increment, note: '화면 표시 시 "J-{id}" 형식으로 노출']
  idempotency_key varchar(150) [not null, unique, note: '동일 논리 작업의 중복 생성·중복 발송 방지 키. ALARM 은 "alarm:{alarm_id}:{next_trigger_at epoch}"']
  job_type background_job_type [not null, note: "현재 사용 필터 기준 (LLM / CHAT / ALARM / EMAIL / DATA_DELETION). OCR은 예약값"]
  status background_job_status [not null, default: 'QUEUED']
  user_id bigint [note: "작업 대상 회원. 시스템 배치성 작업은 null"]
  reference_table varchar(50) [note: "상세 테이블명. chat_messages / alarm_events / email_verifications 중 하나. FK로 강제하지 않는 polymorphic 참조"]
  reference_id bigint [note: "reference_table이 가리키는 테이블의 PK. 회원가입 인증 메일은 email_verifications.id를 논리 참조"]
  requested_at datetime [not null, default: `current_timestamp`, note: "요청시각"]
  started_at datetime [note: "실제 처리 시작 시각"]
  completed_at datetime [note: "처리완료시각. 대기/처리중이면 null"]
  duration_ms int [note: "소요시간(ms) = completed_at - started_at"]
  retry_count int [not null, default: 0]
  max_retry_count int [not null, default: 0]
  parent_job_id bigint [note: '"재처리"로 재생성된 경우에만 원본 작업 참조. 그 외 null']
  error_code varchar(100)
  error_message text
  encrypted_payload text [note: '재시작 복구용 암호화 이메일 작업 payload. 완료·실패·취소 시 null 처리']
  next_attempt_at datetime [note: '재시도 대기 작업의 다음 실행 예정 시각']
  lease_expires_at datetime [note: '처리 중 작업의 실행 lease 만료 시각. 만료 후 재선점 가능']
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    (job_type, status)
    requested_at
    user_id
    (status, requested_at) [name: 'idx_queue_stats', note: "대기중/처리중 카운트 및 실시간 큐 모니터 집계용"]
    (job_type, status, next_attempt_at) [name: 'idx_email_job_retry_due', note: '재시도 시각이 도래한 EMAIL 작업 조회']
    (job_type, status, lease_expires_at) [name: 'idx_email_job_lease', note: 'lease가 만료된 EMAIL 처리 작업 복구']
  }

  checks {
    `retry_count >= 0`
  }

  Note: '''
  "처리 작업 관리" 화면의 단일 데이터 소스.
  idempotency_key는 워커 재시작과 다중 워커 경쟁에서도 같은 논리 작업이 한 번만 생성되도록 한다.

  OCR은 ocr_jobs를 상태 정본으로 사용하며 이 테이블에 중복 행을 만들지 않는다.
  background_job_type.OCR 값은 후속 관리 화면 확장을 위해 유지한다.
  챗봇 응답 생성(chat_messages), 알람 발송(alarm_events) 등 이 통합 로그 대상 작업이
  비동기로 생성될 때마다 이 테이블에 1행씩 기록된다.
  ALARM 타입은 알람 1건이 여러 기기로 fan-out 될 때 발송 건(기기)당 1행씩 생성되어
  화면의 "대상 회원" 단위 로그와 정확히 일치한다.

  실제 도메인 데이터(챗봇 답변 내용, 알림 발송 상세 등)는
  reference_table/reference_id로 각 테이블을 참조해 "상세보기"에서 조회하고,
  이 테이블 자체는 큐 상태·소요시간·재시도 이력만 관리한다.

  ── DATA_DELETION 삭제 순서 [v1.2.5 갱신] ──
  회원탈퇴·개인정보 파기는 아래 순서로 지운다.
  chat_message_sources 의 FK 가 delete: restrict 라서
  단순히 user 를 삭제하면 cascade 연쇄가 restrict 에 막혀 트랜잭션이 실패한다.

    1. chat_message_sources                               (출처 행)
    2. chat_messages, chat_sessions
    3. medication_notes, medication_doses, medication_slots, medications,
       follow_up_visits
       ★ [v5] medication_doses 가 medications 보다 먼저다 —
         care_episode_id cascade 로 함께 지워지지만 순서를 명시해 둔다
    4. alarm_events, alarms, push_subscriptions
    5. care_episodes.source_ocr_job_id·confirmation_hash·confirmed_at 을 null 로 → 해당 사용자의 확정·미확정 ocr_jobs → care_episodes
    6. supplement_review_report
    7. supplement_doses, user_suppl_nutrient_slots, user_suppl_nutrient
    8. user_settings, user

  5번의 순서 주의 — care_episodes.(source_ocr_job_id, id) > ocr_jobs 가 restrict 이므로
  참조를 먼저 끊어야 한다.

  DATA_DELETION은 회원탈퇴 시 개인정보 파기 배치 작업을 추적하기 위한 타입이며,
  현재는 별도 상세 테이블 없이 이 테이블만으로 진행 상태를 관리한다.
  '''
}

Ref: background_jobs.user_id > user.id [delete: cascade]
Ref: background_jobs.parent_job_id > background_jobs.id [delete: set null]

/* =========================================================
   프론트 화면이 읽어야 하는 테이블
   ========================================================= */
/* ---------------------------------------------------------
   확정 복약 — 복약안내(11) · 복약 시간 설정(09) · 약물 변경 비교(13)
   --------------------------------------------------------- */
Table medications {
  id bigint [pk, increment, note: 'API 요청·응답의 medicationId']
  care_episode_id bigint [not null]
  name varchar(255) [not null, note: '사용자가 확인한 최종 약품명']
  strength varchar(100) [note: "사용자가 확인한 최종 함량 문자열. 단위는 mg·mL 등으로 정규화하며 복합 함량도 보존. 예: '500mg', '0.875mg/mL', '10/500mg'"]
  dose_quantity varchar(50) [note: "최종 1회 투약량. 단위가 있으면 함께 저장하고 없으면 값만 저장. 예: '1', '0.5정', '7mL'"]
  times_per_day int [note: '1일 복용 횟수. 미추출 또는 필요 시 복용이면 null 가능']
  days int [note: '이 약의 처방 일수. 케어 종료일은 활성 약 중 가장 긴 일수(MAX days)를 기준으로 계산']
  prescribed_at date [note: '조제약 OCR에서는 약봉투 조제일을 그대로 보존한다. 실제 복용 시작일인 care_episodes.medication_start_date와 구분한다']
  source_ocr_job_id bigint [note: '''
    해당 약을 확정한 OCR 작업의 출처. 최초 확정 시 생성된 처방 케어와 함께 연결한다.
  ''']
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime
  indexes {
    care_episode_id
    (care_episode_id, name)
    (care_episode_id, source_ocr_job_id) [note: '케어와 OCR 출처별 약 조회']
  }
  checks {
    `times_per_day IS NULL OR times_per_day BETWEEN 1 AND 6`
    `days IS NULL OR days BETWEEN 1 AND 365`
  }
  Note: '''
  사용자 확인·수정 후 확정한 약 한 건을 한 행으로 저장한다.
  확정 약이 4개면 이 테이블에 4행을 생성하며 약 목록 전체는 한 번의 확정 요청으로 저장한다.
  검토 중 후보는 ocr_jobs.structured_result에만 있으며 확정 시 이 테이블로 저장한다.
  source_ocr_job_id는 해당 약을 확정한 OCR 작업을 추적한다.
  최초 confirm transaction은 사용자 소유의 READY_FOR_REVIEW 작업을 잠금 상태에서 검증하고 새 케어와 약 목록을 저장한 뒤 작업을 COMPLETE로 변경한다.
  COMPLETE 이후의 제한적 등록 수정은 ocr_jobs의 수정 조건을 따른다.
  조제약 OCR v3는 약품명·함량·1회 투약량·하루 횟수·투약일수만 약별 확정값으로 저장한다.
  약품명은 OCR 원문과 사용자 수정값을 그대로 보존하고, 함량과 투약량 단위만 정규화한다.
  efficacy·administration·precautions·note는 조제약 OCR v3에서 채우지 않는다.
  추출하지 못한 선택 필드는 null로 저장하고 사용자가 검토 화면에서 수정할 수 있다.
  알람·가이드·챗봇은 검토 중 후보가 아니라 이 확정 데이터를 현재 사실로 사용한다.
  복약 안내(REQ-CARE-001)는 활성 케어 전체의 medications 를 통합해 보여준다.
  같은 성분이 두 처방에 겹치는지 확인하는 것이 목적이므로 케어별로 나누지 않는다.
  '''
}

/* 확정 약이 어느 사용자 시간대에 속하는지 */
Table medication_slots {
  id bigint [pk, increment]
  medication_id bigint [not null]
  slot meal_slot [not null]
  created_at datetime [not null, default: `current_timestamp`]
  indexes {
    (medication_id, slot) [unique]
    slot [note: '발송 시 해당 슬롯의 약 목록 조회용']
  }
  Note: '''
  약별 실제 시각이 아니라 복용 시간대만 저장한다.
  실제 발송 시각은 user_settings 의 시간대별 시각을 조인해 얻는다 —
  사용자가 아침을 08:00 → 09:00 으로 바꾸면 user_settings 한 행만 UPDATE 하면 되고
  약별 알람을 다시 만들 필요가 없다.
  OCR 확정 단계에서는 times_per_day와 note만 medications에 저장하고 이 테이블에는 행을 만들지 않는다.
  필요 시 복용(times_per_day IS NULL)인 약은 행을 만들지 않는다.
  발송 시 medication_slots와 medications를 조인해 해당 슬롯의 활성 약 목록을 만든다.
  '''
}

/* ---------------------------------------------------------
   [v5-1 신설] 복용 체크 — 홈 "오늘의 복약" · 복약 기록 그리드
   --------------------------------------------------------- */
Table medication_doses {
  /* [v1.2.5] 실제 모델·DB와 동일하게 기록 생성 시각을 명시한다. */
  id bigint [pk, increment]
  user_id bigint [not null]
  care_episode_id bigint [not null, note: '어느 처방의 복용인지']
  dose_date date [not null]
  slot meal_slot [not null]
  taken_at datetime [not null, default: `current_timestamp`]
  created_at datetime [not null, default: `current_timestamp`, note: '복용 체크 행 생성 시각. taken_at은 체크 시각이며 케어 전체 완료 시각이 아니다']

  indexes {
    (user_id, dose_date, slot, care_episode_id) [unique]
    (user_id, dose_date)
    (care_episode_id, dose_date)
  }

  Note: '''
  처방(care_episode) 단위 슬롯 복약 완료 기록.
  알림 발송 여부와 무관하다. 필요 시 복용약은 대상이 아니다.

  ★ 사용자 단위가 아니다 — 보드 C-3 622:361 이 같은 슬롯에서
    한 처방만 완료된 상태를 그리고 있다.
    활성 처방이 2건이면 점심 슬롯에 최대 2행이 생긴다.

  ★ 슬롯 단위 집계(챌린지 「점심약 먹기」)는
    그 슬롯의 활성 처방이 전부 완료인지로 판정한다.

  '''
}

Ref: medication_doses.user_id > user.id [delete: cascade]
Ref: medication_doses.care_episode_id > care_episodes.id [delete: cascade]

Table medication_notes {
  id bigint [pk, increment, note: '복약 메모 식별자']
  user_id bigint [not null, note: '작성자']
  care_episode_id bigint [not null, note: '처방']
  medication_id bigint [note: '약 (선택). 처방 전체에 대한 메모면 null']
  dosed_at datetime [not null, note: '''
    복용 일시. 사용자가 「이때 먹었다」 고 지정한 시각.
    ★ created_at 과 다르다 — 어제 저녁 약을 먹고 어지러웠던 일을
      오늘 아침에 적을 수 있어야 한다.
      목록 정렬과 화면 표시는 dosed_at 을 쓴다.
  ''']
  body varchar(500) [not null, note: '복용 후 느낀 점']
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime(6) [default: `CURRENT_TIMESTAMP(6)`, note: '실행 DB는 ON UPDATE CURRENT_TIMESTAMP(6)로 수정 시각을 자동 갱신한다. nullable']

  indexes {
    (user_id, dosed_at)
    care_episode_id
  }

  Note: '''
  복약 메모.

  medication_doses 에 note 컬럼을 붙이는 안을 검토했으나 담을 수 없다 —
  medication_doses 는 슬롯 단위 기록이고 약 단위가 아니며,
  보드 E-9 의 작성 화면에는 약 드롭다운이 있다.
  복용 사실(medication_doses)과 사용자가 남긴 말(medication_notes)은 성격이 다르다.

  medication_id 는 nullable 이고 SET NULL 이다 — 약이 지워져도 메모는 남는다.
  care_episode_id 는 CASCADE 다 — 처방을 지우면 메모도 같이 간다.
  처방 없는 메모는 화면에서 부를 자리가 없다.
  '''
}

Ref: medication_notes.user_id > user.id [delete: cascade]
Ref: medication_notes.care_episode_id > care_episodes.id [delete: cascade]
Ref: medication_notes.medication_id > medications.id [delete: set null]

/* ---------------------------------------------------------
   외래 · 검사 일정 — 홈 "다음 일정" · 진료·검사 일정(16)
   --------------------------------------------------------- */
Table follow_up_visits {
  id bigint [pk, increment]
  user_id bigint [not null]
  visit_date date [not null, note: '방문일자']
  visit_time time [note: '방문시간']
  hospital varchar(255) [note: '병원명. 미입력 시 null 허용']
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime
  indexes {
    user_id [note: '사용자별 일정 조회']
    (visit_date, visit_time, id) [note: '일정 화면 날짜·시각·PK 순 통합 목록']
  }
  Note: '''
  조제약 약봉투 OCR에서는 이 테이블을 생성하지 않는다.
  사용자가 진료 일정 API를 통해 별도로 등록·수정하며 user_id로 소유권을 관리한다.

  alarms 로 대체할 수 없다. 알람은 "알려줄 것"이고 일정은 "표시할 사실"이다.
  알람 행이 곧 일정이면 사용자가 알림을 끄는 순간 일정 화면이 비어버린다.
  일정은 날짜순으로 통합해 보여준다 — 케어별로 나누지 않는다.
  각 항목이 날짜·시각·장소를 자기 안에 갖고 있어 출처 표시가 없어도 헷갈리지 않는다.
  외래 예약일은 진료 일정이며 처방의 복약 종료일을 자동으로 연장하지 않는다.
  일정 종류(진료/검사/재활)를 분류하는 컬럼은 두지 않는다 — 분류 규칙이 없어 서버가 추측하게 된다.
  visit_date는 필수이며 visit_time과 hospital은 nullable이다.
  care_episode_id와 source_ocr_job_id는 현재 테이블에 없으며 OCR confirm 저장 대상이 아니다.
  '''
}

Ref: medications.care_episode_id > care_episodes.id [delete: cascade]
Ref: medication_slots.medication_id > medications.id [delete: cascade]
/* 추적용 참조. OCR 원본이 파기돼도 확정 데이터는 남아야 하므로 set null 이다. */
Ref: medications.source_ocr_job_id > ocr_jobs.id [delete: set null]
Ref: follow_up_visits.user_id > user.id [delete: cascade]

/* ---------------------------------------------------------
   건강기능식품 영양성분 표준데이터
   --------------------------------------------------------- */
Table supplement_nutrients {
  id bigint [pk, increment, note: '건강기능식품 영양성분 정보 내부 식별자']
  food_code varchar(20) [not null, unique, note: '식품코드. 원본 데이터에서 제품을 고유하게 식별']
  name varchar(100) [not null, note: '식품명']
  basis_qty varchar(10) [not null, note: '영양성분제공단위량. 예: 450mg, 0.137ml']

  energy_kcal int [not null, note: '제공 단위당 에너지. 단위: kcal']
  water_g decimal(10,3) [note: '제공 단위당 수분 함량. 단위: g']
  protein_g decimal(5,2) [not null, note: '제공 단위당 단백질 함량. 단위: g']
  fat_g decimal(5,2) [note: '제공 단위당 지방 함량. 단위: g']
  ash_g decimal(10,3) [note: '제공 단위당 회분 함량. 단위: g']
  carb_g decimal(6,2) [not null, note: '제공 단위당 탄수화물 함량. 단위: g']
  sugar_g decimal(5,2) [note: '제공 단위당 당류 함량. 단위: g']
  fiber_g decimal(7,1) [note: '제공 단위당 식이섬유 함량. 단위: g']

  calcium_mg int [note: '제공 단위당 칼슘 함량. 단위: mg']
  iron_mg decimal(5,2) [note: '제공 단위당 철 함량. 단위: mg']
  phosphorus_mg int [note: '제공 단위당 인 함량. 단위: mg']
  potassium_mg int [note: '제공 단위당 칼륨 함량. 단위: mg']
  sodium_mg int [note: '제공 단위당 나트륨 함량. 단위: mg']

  vitamin_a_ug_rae int [note: '제공 단위당 비타민 A 함량. 단위: μg RAE']
  retinol_ug int [note: '제공 단위당 레티놀 함량. 단위: μg']
  beta_carotene_ug int [note: '제공 단위당 베타카로틴 함량. 단위: μg']
  thiamine_mg decimal(6,3) [note: '제공 단위당 티아민 함량. 단위: mg']
  riboflavin_mg decimal(6,3) [note: '제공 단위당 리보플라빈 함량. 단위: mg']
  niacin_mg decimal(6,3) [note: '제공 단위당 니아신 함량. 단위: mg']
  vitamin_c_mg decimal(7,2) [note: '제공 단위당 비타민 C 함량. 단위: mg']
  vitamin_d_ug decimal(7,2) [note: '제공 단위당 비타민 D 함량. 단위: μg']

  cholesterol_mg decimal(6,2) [note: '제공 단위당 콜레스테롤 함량. 단위: mg']
  sat_fat_g decimal(4,2) [note: '제공 단위당 포화지방산 함량. 단위: g']
  trans_fat_g decimal(4,2) [note: '제공 단위당 트랜스지방산 함량. 단위: g']

  serving_desc varchar(10) [not null, note: '1회 섭취 분량. 예: 1정, 1캡슐, 5방울']
  serving_size varchar(10) [not null, note: '1회 섭취 분량의 중량 또는 부피. 예: 500mg, 20ml']
  daily_freq varchar(5) [not null, note: '1일 섭취 횟수. 예: 1회, 2회']
  target varchar(10) [note: '권장 섭취 대상. 예: 성인, 성인 남성']

  Note: '''
  전국 건강기능식품 영양성분정보 표준데이터를 저장한다.
  영양성분 값은 basis_qty에 표시된 영양성분 제공 단위를 기준으로 한다.
  원본에서 제공되지 않은 영양성분 값은 null로 보존한다.

  [v5] 하루 총 섭취량 계산은 서버가 수행하고 API 응답에는 계산된 dailyAmount 를 담는다.
  클라이언트가 basis_qty·serving_size 문자열을 파싱해 환산하면 틀린다 —
    · 단위 차원이 섞인다 (450mg ÷ 20ml 는 나눌 수 없다)
    · serving_desc 의 수치를 문자열에서 뽑아야 한다 ('5방울' → 5)
    · ★ vitamin_a_ug_rae · retinol_ug · beta_carotene_ug 를 단순 합산하면
      비타민 A 를 두 번 센다. RAE 는 레티놀 + 베타카로틴/12 의 가중합이고
      기준(nutrient_standard)은 vitamin_a_ug_rae_ul 하나뿐이다.
      이는 단위 변환이 아니라 영양학 규칙이므로 적재·조회 계층에서 정규화한다.
  '''
}
/* =========================================================
   USER SUPPLEMENT NUTRITION
   ========================================================= */
Table user_suppl_nutrient {
  id bigint [pk, increment, note: '사용자 영양제 복용 정보 식별자']
  user_id bigint [not null, note: '영양제를 복용하는 사용자 식별자']

  /* [v5-3] not null 제거. 표준데이터에 없는 제품의 직접 입력을 허용한다.
     프론트에 이미 있는 기능이다 — AddSupplementSheet 의 "제품명 직접 입력". */
  supplement_nutrient_id bigint [note: '''
    건강기능식품 영양성분 기준정보 식별자.
    ★ 직접 입력한 제품이면 null 이고 custom_name 에 제품명이 들어간다.
  ''']
  custom_name varchar(255) [note: '''
    [v5] 직접 입력한 제품명. supplement_nutrient_id 가 null 일 때만 값이 있다.
    ★ 성분은 받지 않는다 — 사용자가 라벨을 옮겨 적다 틀리면 우리가 틀린 계산을 한다.
    이 제품은 성분 합계에서 제외하고, 제외했다는 사실을 화면에 표시한다.
  ''']

  dose_amount decimal(8,3) [not null, note: '1회 복용량 수치. 슬롯당 복용량으로 해석한다']
  dose_unit varchar(20) [not null, note: '정, 캡슐, 포 등 복용량 단위']
  start_date date [not null, note: '복용 시작일']
  end_date date [note: '복용 종료일이며 복용 중에는 NULL']
  status supplement_status [not null, default: 'ACTIVE', note: '현재 복용 상태']
  score int [note: '별점']
  note varchar(500) [note: '사용자 복용 메모']
  review_body varchar(500) [note: '''
    다른 사용자에게 공개되는 후기 본문.
    ★ 공개 대상. note(개인 메모)와 절대 섞지 않는다.
    PATCH 로만 쓴다 — 재등록(PUT upsert)에 포함하면 덮어써져 후기가 사라진다.
  ''']
  created_at datetime [not null, note: '복용 정보 생성 일시']
  updated_at datetime [note: '복용 정보 최종 수정 일시']

  indexes {
    /* [v5-3] 표준데이터 제품에만 중복 방지를 적용한다.
       직접 입력 제품은 supplement_nutrient_id 가 null 이고 제품명이 자유 입력이라
       중복을 막는 의미가 없다. (부분 유니크 인덱스 또는 애플리케이션 계층 검증) */
    (user_id, supplement_nutrient_id) [unique, note: '사용자별 동일 영양제 중복 등록 방지. supplement_nutrient_id 가 null 인 행은 대상 밖']
    (user_id, status) [note: '사용자의 상태별 복용 정보 조회']
  }

  // 복용량은 0보다 커야 함
  // 종료일은 시작일 이후여야 함
  checks {
    `dose_amount > 0` [name: 'chk_user_suppl_dose_positive']
    `end_date is null or end_date >= start_date` [name: 'chk_user_suppl_date_range']
    /* [v5-3] 표준데이터 제품이면 custom_name 이 없고, 직접 입력이면 반대다 */
    `(supplement_nutrient_id IS NOT NULL AND custom_name IS NULL)
      OR (supplement_nutrient_id IS NULL AND custom_name IS NOT NULL)` [name: 'chk_user_suppl_source_exclusive']
  }

  Note: '''
  사용자가 선택한 건강기능식품의 복용량, 기간, 상태를 관리.

  [v5] 표준데이터에 없는 제품은 supplement_nutrient_id 를 null 로 두고 custom_name 에 담는다.
  그 제품은 성분 데이터가 없으므로 성분 합계에 더하지 않는다 —
  조용히 0 으로 더하면 "상한 이내" 가 거짓말이 된다.
  화면에는 목록 카드의 "성분 정보 없음" 배지와 합계 카드의 안내 문구로 그 사실을 밝힌다.

  [v5] 하루 총 섭취량 = dose_amount × (user_suppl_nutrient_slots 행 수) × 1회 성분량.
  dose_amount 는 슬롯당 복용량으로 해석한다 — 아침 2정·저녁 1정 처럼
  슬롯별로 양이 다른 경우는 지원하지 않는다.
  supplement_nutrients.daily_freq 는 제품 라벨의 권장 횟수이며 표시용이다.
  계산에는 사용자가 실제로 정한 슬롯 수를 쓴다.
  '''
}

Table user_suppl_nutrient_slots {
  id bigint [pk, increment, note: '사용자 영양제 복용 시간대 식별자']
  user_suppl_nutrient_id bigint [not null, note: '사용자 영양제 복용 정보 식별자']
  slot meal_slot [not null, note: '아침, 점심, 저녁, 취침 전 복용 시간대']
  created_at datetime [not null, note: '복용 시간대 생성 일시']

  indexes {
    (user_suppl_nutrient_id, slot) [unique, note: '복용 정보별 동일 시간대 중복 방지']
  }

  Note: '''
  사용자 영양제 복용 정보에 연결된 하나 이상의 복용 시간대를 관리.
  [v5] 행 개수가 하루 섭취 횟수다 — 성분 합계 계산의 곱셈 인자다.
  '''
}

Table supplement_doses {
  id bigint [pk, increment]
  registration_id bigint [not null, note: '''
    복용 체크 대상 등록 건. user_suppl_nutrient.id 다.
    ★ user_id 를 따로 두지 않는다 — 등록 건이 이미 사용자에 매여 있다.
      사용자 단위 조회는 user_suppl_nutrient 를 조인한다.
  ''']
  dose_date date [not null]
  slot meal_slot [not null]
  taken_at datetime [not null, default: `current_timestamp`]

  indexes {
    (registration_id, dose_date, slot) [unique]
  }

  Note: '''
  영양제 복용 체크 기록. 등록 건 × 날짜 × 시간대로 한 행이다.

  ★ medication_doses 와 키 구성이 다르다 —
    medication_doses  (user_id, dose_date, slot, care_episode_id)
    supplement_doses  (registration_id, dose_date, slot)
    처방약은 사용자 단위 조회가 잦아 user_id 를 직접 들고 있고,
    영양제는 등록 건 단위라 registration_id 하나로 충분하다.

  ★ 홈의 「개별 선택」·「다 먹었어요」 가 이 테이블을 쓴다.
    처방약의 「먹었어요」 와 저장 구조가 다르므로 문구를 통일하지 않는다.
  '''
}

Ref: supplement_doses.registration_id > user_suppl_nutrient.id [delete: cascade]

// 사용자 삭제 시 복용 정보도 함께 삭제
Ref user_suppl_nutrient_user: user_suppl_nutrient.user_id > user.id [delete: cascade]

// 기준 영양성분이 복용 정보에서 사용 중이면 삭제 제한
Ref user_suppl_nutrient_product: user_suppl_nutrient.supplement_nutrient_id > supplement_nutrients.id [delete: restrict]

// 복용 정보 삭제 시 해당 시간대도 함께 삭제
Ref user_suppl_nutrient_slot: user_suppl_nutrient_slots.user_suppl_nutrient_id > user_suppl_nutrient.id [delete: cascade]


Table supplement_review_report {
  id bigint [pk, increment, note: '후기 신고 식별자']
  user_id bigint [not null, note: '신고한 사용자 식별자']
  registration_id bigint [not null, note: '''
    신고당한 후기의 user_suppl_nutrient 식별자.
    ★ 후기는 별도 행이 아니라 복용 등록 행 자체다.
  ''']
  created_at datetime [not null, note: '신고 일시']

  indexes {
    (user_id, registration_id) [unique, note: '같은 사용자가 같은 후기를 중복 신고하지 못하게 막는다']
    (registration_id) [note: '''
      후기별 신고 수 집계.
      ★ 위 유니크는 user_id 가 선두라 이 조회를 못 타서 별도로 둔다.
    ''']
  }

  Note: '''
  공개 후기 신고. 신고가 3건 모이면 그 후기를 목록·평점 집계에서 숨긴다.

  ★ 숨김 플래그 컬럼을 두지 않는다. 조회할 때 세어서 판정한다.
  ★ 운영자 검토 절차가 없다. 3건이면 자동으로 숨는 것이 전부이고,
    화면에도 "검토됩니다" 라고 쓰지 않는다.
  ★ 신고 사유를 받지 않는다. 읽을 사람이 없다.
  '''
}
/*
  "공개 후기" 판정 — 목록·상세 평점·둘러보기 집계 셋이 같은 제외 목록을 쓴다.

    supplement_nutrient_id = 대상 제품    직접 입력 행(#187)은 이 값이 null 이라 자동 제외
    AND user.status = 'ACTIVE'            탈퇴·정지 회원 후기는 안 보인다
    AND 신고 수 < 3                        자동 숨김
    ★ user_suppl_nutrient.status 는 조건에 넣지 않는다 —
      COMPLETED(복용 종료)여도 후기는 남는다

  술어가 둘이다. 하나로 합치지 않는다.

    표시 대상   score IS NOT NULL OR review_body IS NOT NULL
    평점 모집단 score IS NOT NULL

  그래서 후기 개수(total)와 평점 개수(review_count)가 다를 수 있다. 정상이다.

  작성자 표시 — 컬럼이 없다. user.name 을 응답 시점에 마스킹한다(김동훈 → 김*훈).
  ★ 닉네임 컬럼도, 마스킹 결과 저장 컬럼도 만들지 않는다.
    저장해두면 사용자가 이름을 바꿨을 때 옛 이름이 남는다.
*/

Ref: supplement_review_report.user_id > user.id [delete: cascade]
Ref: supplement_review_report.registration_id > user_suppl_nutrient.id [delete: cascade]

// 2025 한국인 영양소 섭취기준 (엑셀형 구조)
Table nutrient_standard [note: '한국인 영양소 섭취기준. RNI=권장섭취량, AI=충분섭취량, UL=상한섭취량'] {
  id bigint [pk, increment, note: '영양소 섭취기준 ID']
  grp varchar(10) [not null, note: '''
    대상 구분. 원본 표의 "성별" 열이다 —
    영아 · 유아 · 남자 · 여자 · 임신부 · 수유부

    [v5] 임신부·수유부 행의 값은 절대값이 아니라 증감값(+0 형태)이다.
    그리고 임신 여부를 수집하지 않으므로 매칭될 경로가 없다.
    적재하더라도 조회 대상에서 제외한다 — 절대값으로 잘못 쓰이면
    "임신부의 지방 충분섭취량은 0g" 같은 값이 조용히 만들어진다.
  ''']
  age varchar(20) [note: '''
    연령 구간. 원본 표기를 그대로 보존한다 —
    0-5 (개월) · 6-11 · 1-2 (세) · 3-5 · 6-8 (세) · 9-11 ·
    12-14 · 15-18 · 19-29 · 30-49 · 50-64 · 65-74 · 75 이상
    임신부·수유부는 연령 구분이 없어 null 이다.

    [v5] 단위(개월/세)가 grp 에 따라 달라지고 첫 행에만 표기된다.
    '75 이상' 은 범위가 아니라 하한이다.
    ★ 따라서 (grp, age) 매칭은 서버가 수행하고 API 응답에는
      이미 고른 rni·ai·ul 만 담는다. 클라이언트가 파싱하지 않는다.
  ''']

  carb_g_rni decimal(10,3) [note: '탄수화물 권장섭취량(g/일)']
  carb_g_ai decimal(10,3) [note: '탄수화물 충분섭취량(g/일)']
  carb_g_ul decimal(10,3) [note: '탄수화물 상한섭취량(g/일)']
  protein_g_rni decimal(10,3) [note: '단백질 권장섭취량(g/일)']
  protein_g_ai decimal(10,3) [note: '단백질 충분섭취량(g/일)']
  protein_g_ul decimal(10,3) [note: '단백질 상한섭취량(g/일)']
  fat_g_rni decimal(10,3) [note: '지방 권장섭취량(g/일)']
  fat_g_ai decimal(10,3) [note: '지방 충분섭취량(g/일)']
  fat_g_ul decimal(10,3) [note: '지방 상한섭취량(g/일)']
  fiber_g_rni decimal(10,3) [note: '식이섬유 권장섭취량(g/일)']
  fiber_g_ai decimal(10,3) [note: '식이섬유 충분섭취량(g/일)']
  fiber_g_ul decimal(10,3) [note: '식이섬유 상한섭취량(g/일)']
  calcium_mg_rni decimal(10,3) [note: '칼슘 권장섭취량(mg/일)']
  calcium_mg_ai decimal(10,3) [note: '칼슘 충분섭취량(mg/일)']
  calcium_mg_ul decimal(10,3) [note: '칼슘 상한섭취량(mg/일)']
  iron_mg_rni decimal(10,3) [note: '철 권장섭취량(mg/일)']
  iron_mg_ai decimal(10,3) [note: '철 충분섭취량(mg/일)']
  iron_mg_ul decimal(10,3) [note: '철 상한섭취량(mg/일)']
  phosphorus_mg_rni decimal(10,3) [note: '인 권장섭취량(mg/일)']
  phosphorus_mg_ai decimal(10,3) [note: '인 충분섭취량(mg/일)']
  phosphorus_mg_ul decimal(10,3) [note: '인 상한섭취량(mg/일)']
  potassium_mg_rni decimal(10,3) [note: '칼륨 권장섭취량(mg/일)']
  potassium_mg_ai decimal(10,3) [note: '칼륨 충분섭취량(mg/일)']
  potassium_mg_ul decimal(10,3) [note: '칼륨 상한섭취량(mg/일)']
  sodium_mg_rni decimal(10,3) [note: '나트륨 권장섭취량(mg/일)']
  sodium_mg_ai decimal(10,3) [note: '나트륨 충분섭취량(mg/일)']
  sodium_mg_ul decimal(10,3) [note: '나트륨 상한섭취량(mg/일)']
  vitamin_a_ug_rae_rni decimal(10,3) [note: '비타민 A 권장섭취량(μg RAE/일)']
  vitamin_a_ug_rae_ai decimal(10,3) [note: '비타민 A 충분섭취량(μg RAE/일)']
  vitamin_a_ug_rae_ul decimal(10,3) [note: '비타민 A 상한섭취량(μg RAE/일)']
  thiamine_mg_rni decimal(10,3) [note: '티아민 권장섭취량(mg/일)']
  thiamine_mg_ai decimal(10,3) [note: '티아민 충분섭취량(mg/일)']
  thiamine_mg_ul decimal(10,3) [note: '티아민 상한섭취량(mg/일)']
  riboflavin_mg_rni decimal(10,3) [note: '리보플라빈 권장섭취량(mg/일)']
  riboflavin_mg_ai decimal(10,3) [note: '리보플라빈 충분섭취량(mg/일)']
  riboflavin_mg_ul decimal(10,3) [note: '리보플라빈 상한섭취량(mg/일)']
  niacin_mg_rni decimal(10,3) [note: '나이아신 권장섭취량(mg NE/일)']
  niacin_mg_ai decimal(10,3) [note: '나이아신 충분섭취량(mg NE/일)']
  niacin_mg_ul decimal(10,3) [note: '나이아신 상한섭취량(mg NE/일)']
  vitamin_c_mg_rni decimal(10,3) [note: '비타민 C 권장섭취량(mg/일)']
  vitamin_c_mg_ai decimal(10,3) [note: '비타민 C 충분섭취량(mg/일)']
  vitamin_c_mg_ul decimal(10,3) [note: '비타민 C 상한섭취량(mg/일)']
  vitamin_d_ug_rni decimal(10,3) [note: '비타민 D 권장섭취량(μg/일)']
  vitamin_d_ug_ai decimal(10,3) [note: '비타민 D 충분섭취량(μg/일)']
  vitamin_d_ug_ul decimal(10,3) [note: '비타민 D 상한섭취량(μg/일)']

  indexes {
    (grp, age) [name: 'idx_nutrient_standard_grp_age']
  }

  Note: '''
  [v5] 값이 비어 있는 칸이 많다. 원본 표에서 지방·리놀레산 등은
  성인 구간의 네 열이 모두 비어 있고, energy_kcal·sugar_g·cholesterol_mg·
  sat_fat_g·trans_fat_g 는 이 테이블에 컬럼 자체가 없다.

  따라서 "기준 없음" 은 예외가 아니라 흔한 경우다.
  API 응답은 rni·ai·ul 을 전부 null 로 내려주고, 성분을 응답에서 빼지 않는다 —
  사용자가 먹고 있는 성분이므로 수치는 보여주고 판정만 하지 않는다.

  rni 와 ai 는 정의상 동시에 존재하지 않는다 —
  AI 는 RNI 를 정할 근거가 부족할 때 대신 쓰는 값이다.
  둘 다 값이 있는 행이 생기면 적재 오류다.

  ★ 병합 셀 주의 — 원본 표의 "성별" 열은 9행에 걸친 병합 셀이고
  (개월)/(세) 표기도 첫 행에만 있다. 평평한 격자로 읽으면 행이 밀리기 쉽고,
  그 경우 값은 그럴싸하지만 틀린다(여자 19-29 에 남자 75이상 값이 들어감).
  적재 후 한 행만 원본과 대조해 정렬을 확인할 것을 권한다.
  '''
}

Table medication_product_guides {
  id bigint [pk, increment]
  item_seq varchar(20) [not null, unique, note: '식약처 e약은요 품목일련번호']
  product_name varchar(255) [not null]
  manufacturer_name varchar(255) [not null]
  efficacy text [not null]
  usage_instructions text [not null]
  pre_use_warning text [not null]
  precautions text [not null]
  drug_food_interactions text [not null]
  adverse_reactions text [not null]
  storage_instructions text [not null]
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime [not null]

  indexes {
    product_name
  }

  Note: '''
  식약처 e약은요 CSV에서 사용자에게 필요한 제품 안내 원문을 보존한다.
  공개일자 등 현재 서비스에서 사용하지 않는 중복 필드는 적재하지 않는다.
  품목일련번호가 같은 완전 중복 행은 하나로 병합하고 내용 충돌은 적재 전에 차단한다.
  '''
}
/* =========================================================
   성분 정규화 계층
   ========================================================= */

Table interaction_entities {
  id bigint [pk, increment]
  entity_kind interaction_entity_kind [not null]
  canonical_name varchar(255) [not null, note: '사용자 화면과 출처에 표시할 표준 성분·음식 이름']
  normalized_name varchar(255) [not null, note: 'NFKC·공백 정규화·casefold를 적용한 검색 및 pair key 생성용 이름']
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    (entity_kind, normalized_name) [unique]
    canonical_name
  }

  Note: '''
  약, 영양제 성분, 상호작용 대상 음식을 하나의 공통 주체로 관리한다.
  제품명은 이 테이블의 표준 이름으로 사용하지 않고 aliases에 둔다.
  LLM이 새 성분을 임의 생성하지 않으며 importer 또는 관리자 검수로만 추가한다.
  '''
}

Table interaction_entity_aliases {
  id bigint [pk, increment]
  interaction_entity_id bigint [not null]
  alias_type interaction_alias_type [not null]
  alias varchar(255) [not null, note: '표준명과 실제로 다른 성분명·제품명·동의어만 저장']
  normalized_alias varchar(255) [not null, note: '사용자 확정 약명과 비교하기 위한 정규화 별칭']
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (interaction_entity_id, normalized_alias) [unique]
    normalized_alias
  }

  Note: '''
  표준명과 다른 문자열만 저장하며 canonical_name과 같은 별칭은 만들지 않는다.
  사용자 확정 제품명과 출처 성분명이 다른 경우 성분 매칭에 사용한다.
  '''
}

Ref: interaction_entity_aliases.interaction_entity_id > interaction_entities.id [delete: cascade]

/* =========================================================
   치료군 분류
========================================================= */

Table therapeutic_classes {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  display_name varchar(255) [not null]
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime [not null, default: `current_timestamp`]

  indexes {
    display_name
  }
}

Table therapeutic_class_aliases {
  id bigint [pk, increment]
  therapeutic_class_id bigint [not null]
  alias varchar(255) [not null]
  normalized_alias varchar(255) [not null]
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (therapeutic_class_id, normalized_alias) [unique]
    normalized_alias
  }
}

Ref: therapeutic_class_aliases.therapeutic_class_id > therapeutic_classes.id [delete: cascade]

Table interaction_entity_therapeutic_classes {
  id bigint [pk, increment]
  interaction_entity_id bigint [not null]
  therapeutic_class_id bigint [not null]
  review_status interaction_review_status [not null, default: 'PENDING']
  classification_dataset_version varchar(100) [not null]
  source_id varchar(100) [not null]
  document_id varchar(150) [not null]
  record_id varchar(150) [not null]
  raw_classification_text text [not null]
  source_url text
  approved_at datetime
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    (interaction_entity_id, therapeutic_class_id, classification_dataset_version) [unique]
    (therapeutic_class_id, review_status)
    classification_dataset_version
  }
}

Ref: interaction_entity_therapeutic_classes.interaction_entity_id > interaction_entities.id [delete: restrict]
Ref: interaction_entity_therapeutic_classes.therapeutic_class_id > therapeutic_classes.id [delete: restrict]

Table interaction_entity_identifiers {
  id bigint [pk, increment]
  interaction_entity_id bigint [not null]
  source_id varchar(100) [not null, note: '외부 식별자 제공 데이터셋. 예: MFDS_DUR']
  source_code varchar(100) [not null, note: 'DUR 성분코드 등 출처가 제공한 식별자']
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (source_id, source_code) [unique]
  }

  Note: '''
  출처 코드를 저장하기 위해 표준 성분명과 동일한 별칭을 중복 생성하지 않는다.
  출처 코드가 있으면 이름·별칭 매칭보다 우선한다.
  같은 정규화 성분에 출처 코드가 여러 개일 수 있으므로 성분·출처 조합은 유일하지 않다.
  대신 하나의 출처 코드는 하나의 성분에만 연결되도록 source_id·source_code를 유일하게 둔다.
  '''
}

Ref: interaction_entity_identifiers.interaction_entity_id > interaction_entities.id [delete: cascade]

/* =========================================================
   사용자 약·영양제와 표준 성분 연결
   ========================================================= */

Table medication_interaction_mappings {
  id bigint [pk, increment]
  medication_id bigint [not null, unique]
  mapping_status interaction_mapping_status [not null, default: 'PENDING']
  error_code varchar(100) [note: '약 원문이나 개인정보를 포함하지 않는 성분 매핑 실패 코드']
  mapped_at datetime [note: '성분 매핑을 마지막으로 완료한 시각']
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    mapping_status
  }

  Note: '''
  기존 medications 테이블을 변경하지 않고 AI 성분 매핑 상태를 관리한다.
  PENDING·FAILED여도 사용자 확정 약은 유지하며 MATCHED만 결정론적 상호작용 검사에 사용한다.
  '''
}

Table medication_interaction_entities {
  id bigint [pk, increment]
  medication_id bigint [not null]
  interaction_entity_id bigint [not null]
  match_method interaction_match_method [not null]
  match_confidence decimal(5,4) [note: '자동 이름 매칭 신뢰도. SOURCE_CODE·MANUAL이면 null 가능']
  matched_source_text varchar(255) [not null, note: '매칭 당시 사용한 사용자 확정 약명 또는 성분 문자열']
  reviewed_at datetime [note: '수동 검수한 경우 검수 완료 시각']
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (medication_id, interaction_entity_id) [unique]
    interaction_entity_id
  }

  checks {
    `match_confidence IS NULL OR (match_confidence >= 0 AND match_confidence <= 1)`
  }

  Note: '''
  한 약에 여러 유효성분이 있을 수 있으므로 다대다 연결로 둔다.
  medication_interaction_mappings.mapping_status=MATCHED인 약만 상호작용 검사에 사용한다.
  매칭되지 않은 약은 medications에는 남고 챗봇은 "성분을 확인할 수 없음"이라고 안내한다.
  '''
}

Table supplement_interaction_entities {
  id bigint [pk, increment]
  supplement_nutrient_id bigint [not null]
  interaction_entity_id bigint [not null]
  amount decimal(12,4) [note: '원본이 제공한 기준량당 성분 함량. 상호작용 판정에 필요하지 않으면 null 가능']
  unit varchar(30) [note: 'mg, μg RAE 등 원본 단위']
  source_field varchar(100) [note: 'vitamin_c_mg 등 원본 표의 성분 필드명']
  match_method interaction_match_method [not null, default: 'SOURCE_CODE']
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (supplement_nutrient_id, interaction_entity_id) [unique]
    interaction_entity_id
  }

  checks {
    `amount IS NULL OR amount > 0`
    `(amount IS NULL AND unit IS NULL) OR (amount IS NOT NULL AND unit IS NOT NULL)`
  }

  Note: '''
  기존 supplement_nutrients의 고정 영양성분 컬럼을 삭제하지 않고
  상호작용 검색에 필요한 성분 정규화 행을 추가한다.
  user_suppl_nutrient의 표준데이터 제품만 이 매핑을 통해 성분 판정에 사용한다.
  custom_name으로 저장한 직접 입력 제품은 복용 목록에는 유지하지만
  성분이 없으므로 상호작용 판정에서 제외하고 "성분 정보 없음"을 안내한다.
  '''
}

Ref: medication_interaction_mappings.medication_id > medications.id [delete: cascade]
Ref: medication_interaction_entities.medication_id > medications.id [delete: cascade]
Ref: medication_interaction_entities.interaction_entity_id > interaction_entities.id [delete: restrict]
Ref: supplement_interaction_entities.supplement_nutrient_id > supplement_nutrients.id [delete: cascade]
Ref: supplement_interaction_entities.interaction_entity_id > interaction_entities.id [delete: restrict]

/* =========================================================
   결정론적 상호작용 규칙
   ========================================================= */

Table interaction_rules {
  id bigint [pk, increment]
  pair_key char(64) [not null, note: '두 주체의 kind·normalized_name을 정렬해 만든 SHA-256']
  pair_type interaction_pair_type [not null]
  left_entity_id bigint [not null]
  right_entity_id bigint [not null]
  risk_level interaction_risk_level [not null]
  review_status interaction_review_status [not null, default: 'PENDING']
  rule_dataset_version varchar(100) [not null, note: 'RDBMS 규칙 데이터셋의 불변 버전']
  extraction_method interaction_extraction_method [not null]
  approved_at datetime
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    (pair_key, rule_dataset_version) [unique]
    (left_entity_id, right_entity_id)
    (pair_type, review_status, risk_level)
    rule_dataset_version
  }

  checks {
    `left_entity_id <> right_entity_id`
    `(review_status = 'APPROVED' AND approved_at IS NOT NULL) OR (review_status <> 'APPROVED' AND approved_at IS NULL)`
  }

  Note: '''
  같은 조합도 데이터셋 버전별로 누적 저장한다.
  pair_key 단독 전역 유일성은 새 버전 적재를 막으므로 사용하지 않는다.
  런타임에서는 review_status=APPROVED 규칙만 사용한다.
  PENDING staging 후보는 챗봇 답변이나 자동 경고에 사용하지 않는다.
  금기·주의 문구는 interaction_rule_sources.raw_effect_text 한 곳에만 저장한다.
  규칙을 찾지 못한 것은 "상호작용 없음"이 아니라 "확인 가능한 근거 없음"이다.
  '''
}

Table interaction_rule_sources {
  id bigint [pk, increment]
  interaction_rule_id bigint [not null]
  source_id varchar(100) [not null, note: '예: MFDS_DUR']
  document_id varchar(150) [not null]
  record_id varchar(150) [not null, note: '원본 행 식별자. 예: DUR일련번호']
  raw_effect_text text [not null, note: '원본 효과·금기 문구를 변형하지 않고 보존']
  source_published_at date [note: '고시일자 등 출처 정보의 기준일']
  source_url text
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (interaction_rule_id, source_id, document_id, record_id) [unique]
    (source_id, record_id)
  }
}

Table interaction_rule_evidence_chunks {
  id bigint [pk, increment]
  interaction_rule_source_id bigint [not null]
  dataset_key varchar(100) [not null, note: 'Qdrant knowledge 데이터셋 키']
  dataset_version varchar(100) [not null, note: '검색·인덱싱에 사용한 불변 버전']
  vector_chunk_id varchar(255) [not null, note: 'Qdrant point 또는 청크 ID. RDBMS FK가 아니다.']
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (interaction_rule_source_id, dataset_version, vector_chunk_id) [unique]
    vector_chunk_id
  }

  Note: '''
  구조화된 조합·위험도는 interaction_rules가 정본이고,
  상세 설명 원문은 이 링크를 통해 Qdrant에서 검색한다.
  검수되지 않은 청크는 규칙과 연결하지 않는다.
  '''
}

Ref: interaction_rules.left_entity_id > interaction_entities.id [delete: restrict]
Ref: interaction_rules.right_entity_id > interaction_entities.id [delete: restrict]
Ref: interaction_rule_sources.interaction_rule_id > interaction_rules.id [delete: cascade]
Ref: interaction_rule_evidence_chunks.interaction_rule_source_id > interaction_rule_sources.id [delete: cascade]

/* =========================================================
   단일 약물 안전 규칙
   ========================================================= */

Table medication_safety_rules {
  id bigint [pk, increment]
  rule_key char(64) [not null, note: '엔티티·규칙 유형·정규화 조건으로 만든 SHA-256']
  interaction_entity_id bigint [not null]
  rule_type medication_safety_rule_type [not null]
  risk_level interaction_risk_level [not null]
  guidance_text text [not null, note: '검수자가 승인한 사용자용 한국어 안내']
  review_status interaction_review_status [not null, default: 'PENDING']
  rule_dataset_version varchar(100) [not null, note: '단일 약물 안전 규칙 데이터셋의 불변 버전']
  extraction_method interaction_extraction_method [not null]
  approved_at datetime
  created_at datetime [not null, default: `current_timestamp`]
  updated_at datetime

  indexes {
    (rule_key, rule_dataset_version) [unique]
    (interaction_entity_id, rule_type, review_status)
    (rule_dataset_version, review_status)
  }

  checks {
    `rule_key REGEXP '^[0-9a-f]{64}$'`
    `(review_status = 'APPROVED' AND approved_at IS NOT NULL) OR (review_status <> 'APPROVED' AND approved_at IS NULL)`
  }
}

Table medication_safety_rule_conditions {
  id bigint [pk, increment]
  medication_safety_rule_id bigint [not null]
  condition_group_no smallint [not null, note: '같은 그룹은 AND, 다른 그룹은 OR']
  condition_order smallint [not null]
  condition_kind safety_condition_kind [not null]
  comparison_operator safety_comparison_operator [not null]
  value_min decimal(14,4)
  value_max decimal(14,4)
  value_text varchar(255)
  unit varchar(30)
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (medication_safety_rule_id, condition_group_no, condition_order) [unique]
    (condition_kind, comparison_operator)
  }

  checks {
    `condition_group_no >= 1`
    `condition_order >= 1`
    `(comparison_operator <> 'BETWEEN') OR (value_min IS NOT NULL AND value_max IS NOT NULL AND value_min <= value_max)`
    `(comparison_operator NOT IN ('LT', 'LTE', 'GT', 'GTE')) OR value_min IS NOT NULL`
  }
}

Table medication_safety_rule_sources {
  id bigint [pk, increment]
  medication_safety_rule_id bigint [not null]
  source_id varchar(100) [not null]
  document_id varchar(150) [not null]
  record_id varchar(150) [not null]
  raw_effect_text text [not null, note: '원본 주의·금기 내용을 변형하지 않고 보존']
  source_published_at date
  source_url text
  created_at datetime [not null, default: `current_timestamp`]

  indexes {
    (medication_safety_rule_id, source_id, document_id, record_id) [unique]
    (source_id, record_id)
  }
}

Ref: medication_safety_rules.interaction_entity_id > interaction_entities.id [delete: restrict]
Ref: medication_safety_rule_conditions.medication_safety_rule_id > medication_safety_rules.id [delete: cascade]
Ref: medication_safety_rule_sources.medication_safety_rule_id > medication_safety_rules.id [delete: cascade]

/* =========================================================
   런타임 조회 원칙
   =========================================================

   1. 사용자 질문 또는 DB에 저장된 사용자 확정 약 정보 변경
   2. user_id 기준 활성 medications + user_suppl_nutrient 조회
      (custom_name 직접 입력 제품은 목록에 표시하되 성분 판정에서는 제외)
   3. medication_interaction_mappings.mapping_status=MATCHED인 약과 성분 연결 조회
   4. 모든 조합의 pair_key 생성
   5. 배포 설정의 활성 rule_dataset_version과 APPROVED를 함께 만족하는
      interaction_rules만 단건·배치 조회
   6. 연결된 Qdrant 청크로 상세 근거 보강
   7. LLM은 검증된 사실을 친절한 한국어로 표현

   PENDING·FAILED 매핑 약은 기존 medications에 유지하되 상호작용을 추측하지 않는다.
   과거 rule_dataset_version은 답변 이력의 출처 보존용이며 새 답변 판정에는 사용하지 않는다.
   규칙 없음은 안전함이 아니라 확인 가능한 근거가 없음을 의미한다.
   ========================================================= */


Ref: "supplement_nutrients"."id" ?<? "supplement_nutrients"."vitamin_a_ug_rae"

Ref: "alarm_events"."id" -? "user_suppl_nutrient"."id"


/* =========================================================
   영양제 랭킹 전시
========================================================= */
Table display_suppl_nutr_rank {
  id bigint [pk, increment, note: '영양제 랭킹 전시 식별자']
  title varchar(100) [not null, note: '전시 제목']
  start_at datetime [not null, note: '전시 시작 일시']
  end_at datetime [not null, note: '전시 종료 일시']
  is_enabled boolean [not null, default: false, note: '관리자 전시 활성화 여부']
  created_by_admin_id bigint [note: '전시를 생성한 관리자 식별자']
  created_at datetime [not null, note: '전시 생성 일시']
  updated_at datetime [note: '전시 최종 수정 일시']
}

Table suppl_nutr_rank_item {
  id bigint [pk, increment, note: '영양제 랭킹 전시 상품 식별자']
  display_id bigint [not null, note: '영양제 랭킹 전시 식별자']
  supplement_nutrient_id bigint [not null, note: '전시할 건강기능식품 식별자']
  rank_no int [not null, note: '전시 순위. 1부터 5까지 사용']
  created_at datetime [not null, note: '전시 상품 생성 일시']
}

Ref: display_suppl_nutr_rank.created_by_admin_id > admin.id
Ref: suppl_nutr_rank_item.display_id > display_suppl_nutr_rank.id
Ref: suppl_nutr_rank_item.supplement_nutrient_id > supplement_nutrients.id

/* 공통코드 관리 */
Table common_code_groups {
  id bigint [pk, increment, note: '코드 그룹 ID']
  group_code varchar(50) [not null, unique, note: '코드 그룹 (등록 후 변경 불가)']
  group_name varchar(100) [not null, note: '코드 그룹명']
  category varchar(50) [not null, note: '공통코드 대분류']
  description varchar(500) [note: '코드 그룹 설명']
  is_active boolean [not null, default: true, note: '사용 여부']
  created_by_admin_id bigint [note: '등록 관리자 ID']
  updated_by_admin_id bigint [note: '수정 관리자 ID']
  created_at datetime [not null, note: '등록일시']
  updated_at datetime [note: '수정일시']

  Indexes {
    (is_active) [name: 'idx_common_code_groups_active']
    (category, is_active, group_code) [name: 'idx_common_code_groups_category']
  }

  Note: '공통코드 그룹 관리'
}

Table common_codes {
  id bigint [pk, increment, note: '상세 코드 ID']
  group_id bigint [not null, note: '코드 그룹 ID']
  detail_code varchar(50) [not null, note: '상세 코드 (등록 후 변경 불가)']
  detail_name varchar(100) [not null, note: '상세 코드명']
  description varchar(500) [note: '상세 코드 설명']
  sort_order int [not null, default: 0, note: '정렬 순서']
  is_active boolean [not null, default: true, note: '사용 여부']
  created_by_admin_id bigint [note: '등록 관리자 ID']
  updated_by_admin_id bigint [note: '수정 관리자 ID']
  created_at datetime [not null, note: '등록일시']
  updated_at datetime [note: '수정일시']

  Indexes {
    (group_id, detail_code) [unique, name: 'uq_common_codes_group_detail']
    (group_id, is_active, sort_order) [name: 'idx_common_codes_lookup']
  }

  Note: '코드 그룹별 상세 코드 관리'
}

Ref: common_codes.group_id > common_code_groups.id [delete: cascade]
Ref: common_code_groups.created_by_admin_id >? admin.id [delete: set null]
Ref: common_code_groups.updated_by_admin_id >? admin.id [delete: set null]
Ref: common_codes.created_by_admin_id >? admin.id [delete: set null]
Ref: common_codes.updated_by_admin_id >? admin.id [delete: set null]

/* =========================================================
   공식 챌린지·배지 및 사용자 참여 이력
========================================================= */
Enum challenge_verification_status {
  PENDING
  APPROVED
  REJECTED
}

Enum badge_award_status {
  AWARDED
  REVOKED
}

Table badges [note: '공식 챌린지 완료 시 지급하는 배지 관리'] {
  id bigint [pk, increment, note: '배지 ID']
  name varchar(100) [not null, unique, note: '배지 이름']
  description varchar(500) [note: '배지 설명']
  image_path varchar(500) [not null, note: '배지 이미지 상대 경로(media/badges/)']
  type bigint [note: '배지 유형 공통코드 ID(CHL/BDG_TYPE)']
  is_active boolean [not null, default: true, note: '배지 사용 여부']
  created_by_admin_id bigint [note: '등록 관리자 ID']
  updated_by_admin_id bigint [note: '최종 수정 관리자 ID']
  created_at datetime [not null, default: `current_timestamp`, note: '등록 일시']
  updated_at datetime [note: '최종 수정 일시']

  indexes {
    is_active [name: 'idx_badges_active']
    type [name: 'idx_badges_type']
    created_by_admin_id [name: 'idx_badges_created_admin']
    updated_by_admin_id [name: 'idx_badges_updated_admin']
  }
}

Table  custom_challenge_templates  [note: '사용자 맞춤 챌린지 생성에 사용하는 관리 템플릿'] {
  id bigint [pk, increment, note: '맞춤 챌린지 템플릿 ID']
  name varchar(100) [not null, unique, note: '템플릿명']
  is_active boolean [not null, default: true, note: '사용 여부']
  check_type_id bigint [not null, note: '인증 방식 공통코드 ID(CHL/CST_CHK_TYPE)']
  challenge_type bigint [note: '맞춤 챌린지 유형 공통코드 ID(CHL/CST_CHL_TYPE)']
  reward_badge_id bigint [note: '맞춤 챌린지 완료 시 지급할 배지 ID']
  created_by_admin_id bigint [note: '등록 관리자 ID']
  updated_by_admin_id bigint [note: '최종 수정 관리자 ID']
  created_at datetime [not null, default: `current_timestamp`, note: '등록 일시']
  updated_at datetime [note: '최종 수정 일시']

  indexes {
    (is_active, name) [name: 'idx_custom_challenge_templates_active_name']
    check_type_id [name: 'idx_custom_challenge_templates_check_type']
    challenge_type [name: 'idx_custom_challenge_templates_challenge_type']
    reward_badge_id [name: 'idx_custom_challenge_templates_reward_badge']
    created_by_admin_id [name: 'idx_custom_challenge_templates_created_admin']
    updated_by_admin_id [name: 'idx_custom_challenge_templates_updated_admin']
  }
}

Ref: custom_challenge_templates.check_type_id > common_codes.id
Ref: custom_challenge_templates.challenge_type > common_codes.id
Ref: custom_challenge_templates.reward_badge_id > badges.id
Ref: custom_challenge_templates.created_by_admin_id > admin.id
Ref: custom_challenge_templates.updated_by_admin_id > admin.id


Table custom_challenge_participations {
  id bigint [pk, increment]
  user_id bigint [not null]
  template_id bigint [not null]
  reward_badge_id bigint [note: '참여 당시 템플릿의 보상 배지 ID 스냅샷. 보상이 없으면 NULL']
  challenge_type custom_challenge_type [not null, note: '참여 당시 템플릿 공통코드의 유형. VISIT은 예약 값이며 현재 참여 API 미지원']
  challenge_name varchar(100) [not null, note: '참여 당시 템플릿 이름']
  idempotency_key varchar(64) [not null, note: '참여 요청 재시도 키. 같은 키로 다른 템플릿/대상을 요청하면 거부']
  joined_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  end_at datetime(6) [not null, note: '종료 경계(미포함). 복약은 처방의 마지막 복용일 다음 KST 자정, 영양제는 참여일 포함 7일 다음 KST 자정']
  status challenge_participation_status [not null, default: 'ACTIVE']
  target_count int [not null, default: 0, note: '결과 확정 시 저장한 전체 occurrence 수. 날짜 수나 대상 등록 건수가 아님']
  completed_count int [not null, default: 0, note: '결과 확정 시 저장한 완료 occurrence 수']
  progress_rate decimal(5,2) [not null, default: 0, note: '결과 확정 시 완료 occurrence / 전체 occurrence × 100. 목표 0건이면 0']
  completed_at datetime(6) [note: 'COMPLETED로 결과를 확정한 시각. 마지막 dose 기록 시각이 아니며 미완료/취소는 NULL']
  finalized_at datetime(6) [note: '완료/기간 만료/취소 결과를 고정한 시각. 미확정이면 NULL']
  indexes {
    (user_id, idempotency_key) [unique, name: 'uq_custom_participation_request']
    (user_id, status, joined_at) [name: 'idx_custom_participation_user_status']
    template_id [name: 'idx_custom_participation_template']
    reward_badge_id [name: 'idx_custom_participation_reward_badge']
    end_at [name: 'idx_custom_participation_end_at']
  }
  checks {
    `end_at > joined_at`
  }
  Note: '''
  복약은 처방 1건별 참여이며 참여 시점 이후 남은 처방 전체 기간을 대상으로 한다.
  영양제는 선택한 여러 등록 건을 하나의 참여로 묶으며 참여일 포함 7일 범위에서 각 등록의 종료일까지 목표를 만든다.
  ACTIVE 복약 일정 변경은 end_at도 갱신하고, 영양제의 7일 종료 경계는 유지한다.
  목표가 없으면 신규 참여를 거부한다. 참여 후 목표가 0건이 되어도 자동 달성하지 않는다.
  finalized_at이 NULL인 동안 응답의 완료 수/진행률은 원본 dose 기록으로 계산한다. 저장 필드는 실시간 집계가 아니다.
  기간 만료 또는 취소 시 occurrence.is_completed와 참여의 집계/상태/시각을 함께 저장한다.
  만료 시 목표가 1건 이상이고 전부 완료이면 COMPLETED, 나머지는 EXPIRED이며 취소는 CANCELLED이다.
  기간 종료 전 전체 목표 달성 시 상세 화면에서 호출하는 claim-reward가 COMPLETED로 조기 확정하고 배지 지급을 시도한다.
  단순 상세 GET/홈/목록 조회는 기간 전 전체 달성만으로 조기 확정하거나 배지를 지급하지 않는다.
  확정 후에는 원본 복용 기록 변경/삭제로 결과를 다시 계산하지 않는다.
  target_day_count/completed_day_count/day_progress_rate는 occurrence 날짜별 계산 응답 필드이며 DB 컬럼이 아니다.
  같은 날짜의 모든 대상/슬롯 목표를 완료해야 해당 날짜가 달성된다.
  원본 소유권, 유형별 대상 수, 활성 동일 대상 중복 참여는 서버에서 검증한다.
  VISIT Enum/FK는 유지하지만 현재 추천/참여 API는 복약과 영양제만 지원한다.
  '''
}

Table custom_challenge_targets {
  id bigint [pk, increment]
  participation_id bigint [not null]
  care_episode_id bigint [note: 'MEDICATION: care_episodes.id']
  supplement_registration_id bigint [note: 'SUPPLEMENT: user_suppl_nutrient.id. 제품 마스터 ID가 아님']
  follow_up_visit_id bigint [note: 'VISIT 예약용 FK. 현재 맞춤 챌린지 참여 API 미지원']
  source_id_snapshot bigint [not null, note: '참여 당시 원본 ID. 원본 삭제 후에도 보존하며 FK가 아님']
  target_name_snapshot longtext [not null, note: '참여 당시 대상 표시 이름']
  indexes {
    (participation_id, source_id_snapshot) [unique, name: 'uq_custom_target_source']
    care_episode_id [name: 'idx_custom_target_care_episode']
    supplement_registration_id [name: 'idx_custom_target_supplement_registration']
    follow_up_visit_id [name: 'idx_custom_target_follow_up_visit']
  }
  Note: '''
  유형은 participation.challenge_type을 사용한다. 복약은 참여당 대상 1개, 영양제는 1개 이상이다.
  생성 시 참여 유형에 맞는 원본 FK 하나와 source_id_snapshot을 설정하며 소유권/유형 일치는 서버에서 검증한다.
  원본 삭제 시 FK는 NULL이 되고 스냅샷은 남는다. ACTIVE 미래 목표는 일정 재조정 정책을 따른다.
  결과 확정 전에는 원본 dose 변경/삭제가 완료 계산에 영향을 줄 수 있다.
  확정 후에는 저장한 occurrence 완료 상태와 참여 집계를 사용하므로 원본 삭제 후에도 결과가 보존된다.
  '''
}

Table custom_challenge_occurrences {
  id bigint [pk, increment]
  target_id bigint [not null]
  scheduled_date date [not null, note: 'Asia/Seoul 기준 복용 날짜. dose_date와 매칭']
  slot meal_slot [not null]
  scheduled_at datetime(6) [not null, note: '해당 목표의 예정 시각']
  is_completed boolean [not null, default: false, note: '결과 확정 시 저장한 완료 여부. 미확정 응답은 원본 dose로 계산']
  indexes {
    (target_id, scheduled_date, slot) [unique, name: 'uq_custom_occurrence_slot']
    (target_id, scheduled_at) [name: 'idx_custom_occurrence_schedule']
  }
  Note: '''
  복약/영양제의 예정 목표를 저장한다. 같은 처방/날짜/슬롯의 여러 약은 목표 1건이다.
  참여 시점 이후 예정분을 만들고 ACTIVE 일정 변경 시 변경 시각 이전 목표는 유지하며 미래 목표를 재조정한다.
  dose_id/is_taken은 별도로 저장하지 않으며 is_completed는 결과 확정용 스냅샷이다.
  복약 완료: 참여 user_id + 대상 care_episode_id + scheduled_date=dose_date + slot으로 medication_doses 조회.
  영양제 완료: 대상 supplement_registration_id=registration_id + scheduled_date=dose_date + slot으로 supplement_doses 조회.
  원본 소유권을 검증하며 예정되지 않은 dose는 완료 수에 포함하지 않는다.
  '''
}

Table custom_challenge_badge_awards {
  id bigint [pk, increment]
  user_id bigint [not null]
  badge_id bigint [not null]
  participation_id bigint [not null]
  badge_name varchar(100) [not null, note: '지급 당시 배지 이름 스냅샷']
  badge_image_path varchar(500) [not null, note: '지급 당시 배지 이미지 경로 스냅샷']
  awarded_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: '실제 배지 지급 시각']
  indexes {
    (participation_id, badge_id) [unique, name: 'uq_custom_badge_award_participation_badge']
    (user_id, awarded_at) [name: 'idx_custom_badge_award_user_awarded']
    badge_id [name: 'idx_custom_badge_award_badge']
  }
  Note: '''
  결과가 COMPLETED이고 전체 목표를 완료한 참여에서 claim-reward 호출로 지급한다.
  participation.reward_badge_id가 가리키는 배지가 지급 시 활성 상태여야 신규 지급된다.
  동일 참여/배지의 중복 지급은 UNIQUE로 방지한다. 사용자/배지 단위 UNIQUE가 아니므로 다른 참여에서 같은 배지를 받을 수 있다.
  배지 이름과 이미지 경로는 지급 당시 값으로 보존한다. 설명은 스냅샷 컬럼이 아니다.
  기간 만료 작업은 결과만 확정하며 배지 지급은 claim-reward에서 처리한다.
  '''
}
Ref: custom_challenge_participations.user_id > user.id [delete: cascade]
Ref: custom_challenge_participations.template_id > custom_challenge_templates.id [delete: restrict]
Ref: custom_challenge_participations.reward_badge_id > badges.id [delete: restrict]
Ref: custom_challenge_targets.participation_id > custom_challenge_participations.id [delete: cascade]
Ref: custom_challenge_targets.care_episode_id > care_episodes.id [delete: set null]
Ref: custom_challenge_targets.supplement_registration_id > user_suppl_nutrient.id [delete: set null]
Ref: custom_challenge_targets.follow_up_visit_id > follow_up_visits.id [delete: set null]
Ref: custom_challenge_occurrences.target_id > custom_challenge_targets.id [delete: cascade]
Ref: custom_challenge_badge_awards.user_id > user.id [delete: restrict]
Ref: custom_challenge_badge_awards.badge_id > badges.id [delete: restrict]
Ref: custom_challenge_badge_awards.participation_id > custom_challenge_participations.id [delete: restrict]


Table challenges [note: '관리자가 등록하는 공식 건강 챌린지'] {
  id bigint [pk, increment, note: '챌린지 ID']
  name varchar(100) [not null, note: '챌린지명']
  challenge_type bigint [not null, note: '챌린지 유형 공통코드 ID(CHALLENGE/CHL_TYPE)']
  phrase varchar(255) [not null, note: '챌린지 화면에 표시할 짧은 문구']
  description text [note: '챌린지 상세 설명']
  recruit_start_at datetime [not null, note: '모집 시작 일시']
  recruit_end_at datetime [not null, note: '모집 종료 일시']
  challenge_period bigint [not null, note: '챌린지 기간 공통코드 ID(CHALLENGE/CHL_PERIOD)']
  check_type bigint [not null, note: '인증 방식 공통코드 ID(CHALLENGE/CHK_TYPE): SELF 또는 MANUAL']
  check_frequency bigint [not null, note: '인증 빈도 공통코드 ID(CHALLENGE/CHK_FREQ)']
  reward_badge_id bigint [note: '챌린지 완료 시 지급할 배지 ID']
  is_displayed boolean [not null, default: false, note: '사용자 화면 전시 여부']
  is_deleted boolean [not null, default: false, note: '소프트 삭제 여부']
  deleted_at datetime [note: '삭제 처리 일시']
  created_by_admin_id bigint [note: '등록 관리자 ID']
  updated_by_admin_id bigint [note: '최종 수정 관리자 ID']
  created_at datetime [not null, default: `current_timestamp`, note: '등록 일시']
  updated_at datetime [note: '최종 수정 일시']

  indexes {
    (is_displayed, is_deleted, recruit_start_at, recruit_end_at) [name: 'idx_challenges_display_period']
    (challenge_type, is_deleted) [name: 'idx_challenges_type']
    challenge_period [name: 'idx_challenges_period']
    check_type [name: 'idx_challenges_check_type']
    check_frequency [name: 'idx_challenges_check_frequency']
    reward_badge_id [name: 'idx_challenges_reward_badge']
    created_by_admin_id [name: 'idx_challenges_created_admin']
    updated_by_admin_id [name: 'idx_challenges_updated_admin']
  }

  checks {
    `recruit_end_at > recruit_start_at`
  }
}

Table user_challenges [note: '사용자의 공식 챌린지 참여 정보'] {
  id bigint [pk, increment, note: '사용자 챌린지 참여 ID']
  user_id bigint [not null, note: '참여 사용자 ID']
  challenge_id bigint [not null, note: '공식 챌린지 ID']
  status challenge_participation_status [not null, default: 'ACTIVE', note: '참여 상태']
  joined_at datetime [not null, default: `current_timestamp`, note: '참여 신청 일시']
  started_at datetime [not null, note: '실제 챌린지 시작 일시']
  end_at datetime [not null, note: '사용자별 챌린지 종료 예정 일시(배타적)']
  target_count int [not null, default: 0, note: '전체 목표 인증 횟수']
  completed_count int [not null, default: 0, note: '승인된 인증 횟수']
  progress_rate decimal(5,2) [not null, default: 0, note: '현재 진행률(0~100)']
  completed_at datetime [note: '챌린지 완료 일시']
  cancelled_at datetime [note: '참여 취소 일시']
  created_at datetime [not null, default: `current_timestamp`, note: '등록 일시']
  updated_at datetime [note: '최종 수정 일시']

  indexes {
    (user_id, challenge_id) [unique, name: 'uq_user_challenges_user_challenge']
    (user_id, status, joined_at) [name: 'idx_user_challenges_user_status']
    (challenge_id, status) [name: 'idx_user_challenges_challenge_status']
    end_at [name: 'idx_user_challenges_end_at']
  }

  checks {
    `end_at >= started_at`
    `target_count >= 0`
    `completed_count >= 0`
    `progress_rate >= 0 AND progress_rate <= 100`
  }
}

Table challenge_progress [note: '사용자 챌린지의 인증 주기별 진행률'] {
  id bigint [pk, increment, note: '진행률 ID']
  user_challenge_id bigint [not null, note: '사용자 챌린지 참여 ID']
  period_start date [not null, note: '진행률 집계 시작일']
  period_end date [not null, note: '진행률 집계 종료일']
  target_count int [not null, default: 0, note: '해당 기간 목표 인증 횟수']
  completed_count int [not null, default: 0, note: '해당 기간 승인 인증 횟수']
  progress_rate decimal(5,2) [not null, default: 0, note: '해당 기간 진행률(0~100)']
  is_completed boolean [not null, default: false, note: '해당 기간 목표 달성 여부']
  completed_at datetime [note: '해당 기간 목표 달성 일시']
  created_at datetime [not null, default: `current_timestamp`, note: '등록 일시']
  updated_at datetime [note: '최종 수정 일시']

  indexes {
    (user_challenge_id, period_start, period_end) [unique, name: 'uq_challenge_progress_period']
    (user_challenge_id, is_completed) [name: 'idx_challenge_progress_completed']
    period_end [name: 'idx_challenge_progress_period_end']
  }

  checks {
    `period_end >= period_start`
    `target_count >= 0`
    `completed_count >= 0`
    `progress_rate >= 0 AND progress_rate <= 100`
  }
}

Table challenge_verifications [note: '사용자가 제출한 챌린지 인증 기록'] {
  id bigint [pk, increment, note: '챌린지 인증 ID']
  user_challenge_id bigint [not null, note: '사용자 챌린지 참여 ID']
  progress_id bigint [not null, note: '인증이 반영될 진행률 ID']
  verification_date date [not null, note: '사용자 기준 인증일']
  content varchar(500) [note: '사용자 인증 내용']
  image_path varchar(500) [note: '인증 이미지 상대 경로(media/challenges/)']
  status challenge_verification_status [not null, default: 'PENDING', note: '인증 처리 상태']
  rejection_reason varchar(500) [note: '인증 반려 사유']
  reviewed_by_admin_id bigint [note: '수동 인증 검토 관리자 ID']
  reviewed_at datetime [note: '승인 또는 반려 처리 일시']
  idempotency_key varchar(64) [not null, unique, note: '인증 중복 등록 방지 키']
  submitted_at datetime [not null, default: `current_timestamp`, note: '인증 제출 일시']
  created_at datetime [not null, default: `current_timestamp`, note: '등록 일시']
  updated_at datetime [note: '최종 수정 일시']

  indexes {
    (user_challenge_id, verification_date) [unique, name: 'uq_challenge_verifications_daily']
    (status, submitted_at) [name: 'idx_challenge_verifications_review']
    progress_id [name: 'idx_challenge_verifications_progress']
    reviewed_by_admin_id [name: 'idx_challenge_verifications_admin']
  }
}

Table user_badges [note: '챌린지 완료에 따른 사용자 배지 지급 이력'] {
  id bigint [pk, increment, note: '사용자 배지 지급 ID']
  user_id bigint [not null, note: '배지 지급 사용자 ID']
  badge_id bigint [not null, note: '지급 배지 ID']
  challenge_id bigint [not null, note: '배지 지급 기준 챌린지 ID']
  user_challenge_id bigint [not null, note: '완료한 사용자 챌린지 참여 ID']
  status badge_award_status [not null, default: 'AWARDED', note: '배지 지급 상태']
  badge_name varchar(100) [not null, note: '지급 당시 배지 이름 스냅샷']
  badge_image_path varchar(500) [not null, note: '지급 당시 활성 배지 이미지 경로']
  awarded_at datetime [not null, default: `current_timestamp`, note: '배지 지급 일시']
  revoked_at datetime [note: '배지 회수 일시']
  revoke_reason varchar(500) [note: '배지 회수 사유']
  created_at datetime [not null, default: `current_timestamp`, note: '등록 일시']
  updated_at datetime [note: '최종 수정 일시']

  indexes {
    (user_challenge_id, badge_id) [unique, name: 'uq_user_badges_participation_badge']
    (user_id, status, awarded_at) [name: 'idx_user_badges_user_status']
    (challenge_id, awarded_at) [name: 'idx_user_badges_challenge']
  }
}

