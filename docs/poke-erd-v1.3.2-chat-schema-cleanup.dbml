/* =========================================================
   ENUM
========================================================= */
Enum account_status {
  PENDING
  ACTIVE
  SUSPENDED
  WITHDRAWN
}
Enum admin_role {
  ADMIN
  STAFF
}

Enum gender {
  MALE
  FEMALE
}

Enum ocr_job_status {
  QUEUED
  PROCESSING
  READY_FOR_REVIEW
  COMPLETE
  FAILED
  CANCELLED
}
/* [v4] 알림 토글 이력의 대상 항목. user_settings 컬럼명과 1:1 로 맞춘다 */
Enum notify_setting_key {
  IS_NOTIFY_MEDICATION
  IS_NOTIFY_SCHEDULE
  IS_NOTIFY_GUIDE
}
Enum meal_slot {
  MORNING    // 아침약
  LUNCH      // 점심약
  EVENING    // 저녁약
  BEDTIME    // 취침약
}
