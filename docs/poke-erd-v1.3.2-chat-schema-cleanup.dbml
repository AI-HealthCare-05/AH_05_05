  MEDICATION        // 복약
  FOLLOW_UP_VISIT   // 재방문 일정
  GUIDE_CHECK       // 생활관리 가이드 확인 예약값. 이번 ERD에서는 가이드 FK 없이 유지
  NUTRIENT          // 영양제 성분
}
Enum background_job_type {
  OCR
  LLM
  CHAT
  ALARM
  EMAIL
  DATA_DELETION
}
Enum background_job_status {
